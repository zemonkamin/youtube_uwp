<Page
    x:Class="YouTube.History"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ScrollViewer x:Name="HistoryScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="HistoryScroll_ViewChanged">
                <StackPanel Padding="16,16,16,20">
                    <TextBlock x:Uid="Loc_History_Text"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,12,0,16"/>

                    <ItemsControl x:Name="HistoryGroupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding DateTitle}"
                                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>

                                    <ItemsControl ItemsSource="{Binding Videos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CardButtonStyle}" Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        Margin="0,0,0,12"
                                                        Click="VideoCard_Click">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Grid.Column="0"
                                                              Width="160"
                                                              Height="90">
                                                            <Border Background="{ThemeResource AppSurfaceAltBrush}"/>
                                                            <Image DataContextChanged="HistoryThumbnail_DataContextChanged"
                                                                   Stretch="UniformToFill"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Stretch" />
                                                            <Image Stretch="Fill"
                                                                   IsHitTestVisible="False"
                                                                   local:ThemeAsset.Path="Assets/rounding_up.png"/>

                                                            <Border HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="0,0,5,5"
                                                                    Padding="4,1"
                                                                    CornerRadius="4"
                                                                    Background="#D1000000">
                                                                <TextBlock Text="{Binding Duration}"
                                                                           Foreground="White"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>

                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                                       FontSize="14"
                                                                       FontWeight="Normal"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxLines="3"/>
                                                            <TextBlock Text="{Binding ChannelTitle}"
                                                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                                       FontSize="12"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="BottomLoadingPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,26">
                        <local:AndroidLoadingRing x:Name="BottomLoadingRing"
                                                  Width="34"
                                                  Height="34"
                                                  IsActive="False"/>
                        <TextBlock x:Uid="Loc_LoadingMoreHistory_Text"
                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock x:Uid="Loc_NoHistoryYet_Text" x:Name="EmptyText"
                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="Collapsed"
                               Margin="0,36,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LoadingOverlay"
                  Background="{ThemeResource AppBackgroundBrush}"
                  Visibility="Collapsed">
                <local:AndroidLoadingRing x:Name="LoadingRing"
                                          Width="48"
                                          Height="48"
                                          IsActive="False"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <local:Tabbar x:Name="tabbar" Grid.Row="1"/>
    </Grid>
</Page>
