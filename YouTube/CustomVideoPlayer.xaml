<UserControl
    x:Class="YouTube.CustomVideoPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">
    
    <UserControl.Resources>
        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Custom Slider Style -->
        <Style x:Key="CustomSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="#f03"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="SliderContainer" Grid.Row="1">
                                <Grid x:Name="HorizontalTemplate" MinHeight="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Passive rounded base. This fills tiny transparent corners, but it is not used by Slider logic. -->
                                    <Rectangle Fill="{TemplateBinding Background}"
                                               Height="4"
                                               Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               HorizontalAlignment="Stretch"
                                               RadiusX="2"
                                               RadiusY="2"
                                               IsHitTestVisible="False"/>

                                    <!-- Required Slider part: keep it in column 2 so the thumb/value calculation continues to work. -->
                                    <Rectangle x:Name="HorizontalTrackRect"
                                               Fill="{TemplateBinding Background}"
                                               Height="4"
                                               Grid.Row="1"
                                               Grid.Column="2"
                                               HorizontalAlignment="Stretch"
                                               RadiusX="2"
                                               RadiusY="2"/>

                                    <!-- Required Slider part: keep it as a Rectangle in column 0. Do not span into the thumb column. -->
                                    <Rectangle x:Name="HorizontalDecreaseRect"
                                               Fill="{TemplateBinding Foreground}"
                                               Height="4"
                                               Grid.Row="1"
                                               Grid.Column="0"
                                               HorizontalAlignment="Stretch"
                                               RadiusX="2"
                                               RadiusY="2"/>

                                    <!-- Visual bridges under the thumb. They remove the rounded-corner gap without changing Slider layout. -->
                                    <Rectangle Fill="{TemplateBinding Foreground}"
                                               Height="4"
                                               Width="8"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               HorizontalAlignment="Left"
                                               IsHitTestVisible="False"/>
                                    <Rectangle Fill="{TemplateBinding Background}"
                                               Height="4"
                                               Width="8"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               IsHitTestVisible="False"/>

                                    <!-- Thumb (red circle) -->
                                    <Thumb x:Name="HorizontalThumb"
                                           Grid.Row="0"
                                           Grid.RowSpan="3"
                                           Grid.Column="1"
                                           Height="16"
                                           Width="16"
                                           AutomationProperties.AccessibilityView="Raw">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#f03" Width="16" Height="16"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Custom Thumb Style -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#FF0000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PlayerGrid" Background="Transparent" DoubleTapped="MediaPlayer_DoubleTapped"
          SizeChanged="PlayerGrid_SizeChanged"
          PointerPressed="PlayerGrid_PointerPressed"
          PointerMoved="PlayerGrid_PointerMoved"
          PointerReleased="PlayerGrid_PointerReleased"
          PointerCanceled="PlayerGrid_PointerReleased"
          PointerCaptureLost="PlayerGrid_PointerReleased">
        <!-- A live blurred copy of the active video. MediaPlayer itself still renders only the
             sharp center image; this layer fills letterbox/pillarbox space with current frames. -->
        <Grid x:Name="AmbientVideoHost"
              Background="#0f0f0f"
              IsHitTestVisible="False" />

        <!-- MediaPlayerElement -->
        <MediaPlayerElement x:Name="MediaPlayer" 
                           AreTransportControlsEnabled="False"
                           Background="Transparent"
                           DoubleTapped="MediaPlayer_DoubleTapped"
                           Tapped="MediaPlayer_Tapped"
                           PointerMoved="MediaPlayer_PointerMoved"
                           PointerExited="MediaPlayer_PointerExited"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Margin="0"/>

        <!-- MediaPlayerElement paints its own letterbox area opaque black on older UWP builds,
             even with a transparent Background. These four live-video hosts sit only over the
             calculated bar rectangles, leaving the sharp video itself untouched. -->
        <Grid x:Name="AmbientTopBarHost"
              Height="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              IsHitTestVisible="False" />
        <Grid x:Name="AmbientBottomBarHost"
              Height="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              IsHitTestVisible="False" />
        <Grid x:Name="AmbientLeftBarHost"
              Width="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              IsHitTestVisible="False" />
        <Grid x:Name="AmbientRightBarHost"
              Width="0"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              IsHitTestVisible="False" />

        <!-- Hidden audio player (for separate HLS audio playlists) -->
        <MediaPlayerElement x:Name="AudioPlayer"
                           AreTransportControlsEnabled="False"
                           Visibility="Visible"
                           IsHitTestVisible="False"
                           Width="0"
                           Height="0"
                           Opacity="0" />
        
        <!-- Subtitles. Above the video but below ControlsOverlay, so the controls stay readable
             when they fade in over a caption. -->
        <Border x:Name="SubtitleOverlay"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#B0000000"
                CornerRadius="4"
                Padding="8,4"
                Margin="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SubtitleOverlayTransform" X="0" Y="0"/>
            </Border.RenderTransform>
            <TextBlock x:Name="SubtitleText"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxLines="3"/>
        </Border>

        <!-- Skip overlay for fullscreen mode -->
        <Grid x:Name="SkipOverlayFullscreen" Visibility="Collapsed" Background="Transparent" IsHitTestVisible="False">
            <Border x:Name="SkipOverlayBorderFullscreen" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Padding="20" CornerRadius="8" Margin="20,0,0,0">
                <StackPanel x:Name="SkipOverlayPanelFullscreen" Orientation="Horizontal">
                    <Image x:Name="SkipIconFullscreen" Width="48" Height="48" Margin="0,0,10,0"/>
                    <TextBlock x:Name="SkipTextFullscreen" Text="-10" Foreground="White" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Overlay controls -->
        <Grid x:Name="ControlsOverlay" Background="Transparent" DoubleTapped="MediaPlayer_DoubleTapped">
            <!-- Title + author, top-left, fullscreen only. Fades with the controls. The settings
                 button occupies the top-right, so leave room for it. -->
            <StackPanel x:Name="FullscreenTitlePanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,10,64,0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                <TextBlock x:Name="FullscreenTitleText"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FullscreenAuthorText"
                           Foreground="#DDDDDD"
                           FontSize="13"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Minimize to the floating mini-player. Hidden in fullscreen, where the top-left
                 belongs to the title, and in mini mode. -->
            <Button x:Name="MinimizeButton"
                    Click="MinimizeButton_Click"
                    PointerPressed="ControlButton_PointerPressed"
                    Style="{StaticResource ControlButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="44"
                    Height="44"
                    Margin="6,6,0,0"
                    Opacity="0.8"
                    IsDoubleTapEnabled="False">
                <Button.Content>
                    <Image local:ThemeAsset.Path="Assets/Dark/player/down_arrow.png"
                           Width="20"
                           Height="20"/>
                </Button.Content>
            </Button>

            <!-- Settings button in top right -->
            <Button x:Name="SettingsButton"
                    Click="SettingsButton_Click"
                    PointerPressed="ControlButton_PointerPressed"
                    Style="{StaticResource ControlButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="44"
                    Height="44"
                    Margin="0,6,6,0"
                    Opacity="0.8"
                    IsDoubleTapEnabled="False">
                <Button.Content>
                    <Image x:Name="SettingsIcon" 
                           local:ThemeAsset.Path="Assets/Dark/player/settings.png" 
                           Width="20" 
                           Height="20"/>
                </Button.Content>
            </Button>
            
            <!-- Center play/pause button -->
            <Button x:Name="PlayPauseButton"
                    Click="PlayPauseButton_Click"
                    Style="{StaticResource ControlButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="80"
                    Height="80"
                    Opacity="0.8"
                    IsDoubleTapEnabled="False">
                <Button.Content>
                    <Image x:Name="PlayPauseIcon" 
                           local:ThemeAsset.Path="Assets/Dark/player/play.png" 
                           Width="48" 
                           Height="48"/>
                </Button.Content>
            </Button>
            
            <!-- Replay button (shown when video ends) -->
            <Button x:Name="ReplayButton"
                    Click="ReplayButton_Click"
                    Style="{StaticResource ControlButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="80"
                    Height="80"
                    Opacity="0"
                    Visibility="Collapsed"
                    IsDoubleTapEnabled="False">
                <Button.Content>
                    <Image x:Name="ReplayIcon" 
                           local:ThemeAsset.Path="Assets/Dark/player/replay.png" 
                           Width="48" 
                           Height="48"/>
                </Button.Content>
            </Button>

            <!-- Shown while a newly selected quality stream is being prepared. Playback and
                 seeking stay blocked until the new source is actually ready. -->
            <local:AndroidLoadingRing x:Name="SourceLoadingRing"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Width="56"
                                      Height="56"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False">
                <!-- The player spinner is always drawn over video, so it must stay white
                     in both app themes. Keep the app-wide LoadingRingBrush unchanged for
                     page-level spinners, which remain black in Light theme. -->
                <local:AndroidLoadingRing.Resources>
                    <SolidColorBrush x:Key="LoadingRingBrush" Color="White"/>
                </local:AndroidLoadingRing.Resources>
            </local:AndroidLoadingRing>

            <!-- Bottom controls panel -->
            <Grid x:Name="BottomControlsPanel" 
                  VerticalAlignment="Bottom"
                  Height="80"
                  Margin="0,0,0,0">
                <Grid.Background>
                    <ImageBrush local:ThemeAsset.Path="Assets/player/bg.png" Stretch="Fill"/>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Top row: Time display, and Fullscreen button -->
                <Grid Grid.Row="0" Height="40" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Time display -->
                    <Border Grid.Column="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="16,0,8,0"
                              Background="#80000000"
                              CornerRadius="15">
                        <TextBlock x:Name="TimeDisplayText"
                                   Text="0:00 / 0:00"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="10,5"/>
                    </Border>
                    
                    <!-- Fullscreen button -->
                    <Button x:Name="FullscreenButton"
                            Grid.Column="1"
                            Click="FullscreenButton_Click"
                            PointerPressed="ControlButton_PointerPressed"
                            Style="{StaticResource ControlButtonStyle}"
                            Margin="0,0,16,0"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsDoubleTapEnabled="False">
                        <Button.Content>
                            <Image x:Name="FullscreenIcon" 
                                   local:ThemeAsset.Path="Assets/Dark/player/fullscreen.png" 
                                   Width="20" 
                                   Height="20"/>
                        </Button.Content>
                    </Button>
                </Grid>
                
                <!-- Bottom row: Progress slider on full width -->
                <Grid Grid.Row="1"
                      Height="20"
                      VerticalAlignment="Bottom"
                      Margin="16,0,16,8">
                    <!-- Real visible timeline. Chapter/timecode gaps are built into this grid,
                         not painted over a continuous Slider track. -->
                    <Grid x:Name="SegmentedProgressBar"
                          Height="4"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"
                          IsHitTestVisible="False"
                          SizeChanged="SegmentedProgressBar_SizeChanged"/>

                    <!-- SponsorBlock ranges, painted over the track so they stay visible whether
                         or not that part has been watched. -->
                    <Canvas x:Name="SponsorOverlay"
                            Height="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            IsHitTestVisible="False"/>

                    <!-- Transparent Slider keeps the red thumb/value math. The visible track is SegmentedProgressBar. -->
                    <Slider x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            ValueChanged="ProgressSlider_ValueChanged"
                            ManipulationStarted="ProgressSlider_ManipulationStarted"
                            ManipulationCompleted="ProgressSlider_ManipulationCompleted"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Height="20"
                            ManipulationMode="TranslateX"
                            IsEnabled="True"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Background="Transparent"
                            Foreground="Transparent"
                            Style="{StaticResource CustomSliderStyle}"/>

                    <!-- Full hit area maps touches to the segmented timeline. Taps on gaps snap to a chapter edge. -->
                    <Border x:Name="ProgressSliderHitArea"
                            Background="Transparent"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Tapped="ProgressSliderTrack_Tapped"
                            PointerPressed="ProgressSlider_PointerPressed"
                            PointerMoved="ProgressSlider_PointerMoved"
                            PointerReleased="ProgressSlider_PointerReleased"
                            PointerCanceled="ProgressSlider_PointerCanceled"
                            PointerCaptureLost="ProgressSlider_PointerCaptureLost"/>
                </Grid>
            </Grid>
            
            <!-- Error message display at the bottom -->
            <TextBlock x:Name="ErrorMessageText"
                       Text=""
                       Foreground="Red"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,5"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Scrub preview: a single frame from the video's storyboard sprite sheet, shown above
             the seek bar while the user drags/holds. Kept OUTSIDE ControlsOverlay and last in the
             player grid so the controls' fade-out cannot dim it and it always sits on top. The
             inner image is larger than the clip and shifted so only the target tile shows. -->
        <Border x:Name="ScrubPreviewPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0,0,0,48"
                Background="Transparent"
                Padding="0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ScrubPreviewTransform"/>
            </Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center">
                <Border x:Name="ScrubPreviewClip"
                        Width="120"
                        Height="67.5"
                        BorderBrush="White"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Border.Background>
                        <ImageBrush x:Name="ScrubPreviewBrush"
                                    Stretch="None"
                                    AlignmentX="Left"
                                    AlignmentY="Top">
                            <ImageBrush.Transform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScrubPreviewScale"/>
                                    <TranslateTransform x:Name="ScrubPreviewImageTransform"/>
                                </TransformGroup>
                            </ImageBrush.Transform>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="ScrubPreviewTime"
                           Text="0:00"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Fullscreen related videos. Kept inside the player so it follows the same control into
             the fullscreen Popup. The dim layer and bottom panel are animated independently; the
             horizontal ScrollViewer remains the only scrolling surface inside the panel. -->
        <Grid x:Name="FullscreenRelatedOverlay"
              Visibility="Collapsed"
              Canvas.ZIndex="300">
            <Grid x:Name="FullscreenRelatedBackdrop"
                  Background="#B8000000"
                  Opacity="0"
                  Tapped="FullscreenRelatedBackdrop_Tapped"/>

            <Border x:Name="FullscreenRelatedPanel"
                    Height="196"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="Transparent">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FullscreenRelatedPanelTransform" Y="196"/>
                </Border.RenderTransform>
                    <ScrollViewer
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled">
                        <ItemsControl x:Name="FullscreenRelatedItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="232"
                                            Height="184"
                                            Margin="10,0,2,8"
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="FullscreenRelatedCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="130"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Background="#252525">
                                                <Image Source="{Binding ThumbnailSource}"
                                                       Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,6,6"
                                                        Padding="5,2"
                                                        CornerRadius="3"
                                                        Background="#CC000000">
                                                    <TextBlock Text="{Binding Duration}"
                                                               Foreground="White"
                                                               FontSize="11"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="2,7,2,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Author}"
                                                           Foreground="#BFFFFFFF"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
