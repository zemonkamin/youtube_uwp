<Page
    x:Class="YouTube.Tabbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border x:Name="TabbarGlassHost"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="Transparent"
                IsHitTestVisible="False" />
        <!-- Top dark gray bar -->
        <Border Grid.Row="0" Background="{ThemeResource AppDividerBrush}"/>
        <!-- Bottom TabBar -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HomeColumn" Width="*"/>
                <ColumnDefinition x:Name="ShortsColumn" Width="*"/>
                <ColumnDefinition x:Name="SubscriptionsColumn" Width="*"/>
                <ColumnDefinition x:Name="AccountColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Home -->
            <Button x:Name="HomeButton" Grid.Column="0" 
                    Background="Transparent" 
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="HomeTab_Click">
                <StackPanel Orientation="Vertical" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Image local:ThemeAsset.Path="Assets/tabbar/home-icon.png" 
                           Width="24" 
                           Height="24"
                           Stretch="Uniform"/>
                    <TextBlock x:Uid="Loc_Home_Text" 
                               Foreground="{ThemeResource AppPrimaryTextBrush}" 
                               Margin="0,0,0,0"
                               FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Shorts -->
            <Button x:Name="ShortsButton" Grid.Column="1" 
                    Background="Transparent" 
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="ShortsTab_Click">
                <StackPanel Orientation="Vertical"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Image local:ThemeAsset.Path="Assets/tabbar/shorts-icon.png" 
                           Width="24" 
                           Height="24"
                           Stretch="Uniform"/>
                    <TextBlock x:Uid="Loc_Shorts_Text" 
                               Foreground="{ThemeResource AppPrimaryTextBrush}" 
                                Margin="0,0,0,0"
                              FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Subscriptions -->
            <Button x:Name="SubscriptionsButton" Grid.Column="2" 
                    Background="Transparent" 
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="SubscriptionsTab_Click">
                <StackPanel Orientation="Vertical"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Image local:ThemeAsset.Path="Assets/tabbar/sub-icon.png" 
                           Width="24" 
                           Height="24"
                           Stretch="Uniform"/>
                    <TextBlock x:Uid="Loc_Subscriptions_Text" 
                               Foreground="{ThemeResource AppPrimaryTextBrush}" 
                                Margin="0,0,0,0"
                              FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Account -->
            <Button x:Name="AccountButton" Grid.Column="3" 
                    Background="Transparent" 
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="AccountButton_Click">
                <StackPanel Orientation="Vertical"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Image x:Name="AccountDefaultIcon"
                               local:ThemeAsset.Path="Assets/tabbar/user-icon.png" 
                               Width="24" 
                               Height="24"
                               Stretch="Uniform"/>
                        <Ellipse x:Name="AccountAvatarEllipse"
                                 Width="24"
                                 Height="24"
                                 Fill="{ThemeResource AvatarPlaceholderBrush}"
                                 Stroke="Transparent"
                                 StrokeThickness="1.5"
                                 Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Uid="Loc_You_Text" 
                               Foreground="{ThemeResource AppPrimaryTextBrush}" 
                               Margin="0,0,0,0"
                               FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
