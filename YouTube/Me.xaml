<Page
    x:Class="YouTube.Me"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource PrimaryActionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource PrimaryActionForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same outlined pill foundation as the QR refresh button on Login. -->
        <Style x:Key="AccountsPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="38" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="0,10,0,76">
                    <!-- Top bar -->
                    <Grid Height="44" Margin="16,0,16,4">
                        <Button x:Name="AccountsButton"
                                Style="{StaticResource AccountsPillButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="AccountsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AccountsButtonText"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppPrimaryTextBrush}" />
                                <Image local:ThemeAsset.Path="Assets/down_arrow.png"
                                       Width="12"
                                       Height="12"
                                       Margin="9,1,0,0"
                                       Stretch="Uniform" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="SearchButton"
                                    Width="38"
                                    Height="38"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8"
                                    Click="SearchButton_Click">
                                <Image local:ThemeAsset.Path="Assets/search.png"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="SettingsButton"
                                    Width="38"
                                    Height="38"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    Click="SettingsButton_Click">
                                <Image local:ThemeAsset.Path="Assets/player/settings.png"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Profile -->
                    <Grid Margin="16,6,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Width="60"
                                 Height="60"
                                 VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ProfileImageBrush"
                                            Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Uid="Loc_Loading_Text" x:Name="DisplayNameText"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock x:Name="ChannelHandleText"
                                       Text=""
                                       Margin="0,3,0,0"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="GoToChannelButton"
                            Style="{StaticResource ChannelActionButtonStyle}"
                            Height="40"
                            Margin="16,0,16,24"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed"
                            Click="GoToChannelButton_Click">
                        <TextBlock x:Uid="Loc_ViewChannel_Text"
                                   Foreground="{ThemeResource PrimaryActionForegroundBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </Button>

                    <!-- History -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Margin="16,0,16,8"
                            Click="HistoryHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Uid="Loc_History_Text"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" &#x203A;"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       FontSize="24"
                                       Margin="3,-3,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  ZoomMode="Disabled"
                                  Margin="0,0,0,20">
                        <ItemsControl x:Name="HistoryList"
                                      Margin="16,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CardButtonStyle}" Width="160"
                                            Margin="0,0,16,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Click="VideoCard_Click">
                                        <StackPanel>
                                            <Grid Width="160" Height="90">
                                                <Border Background="{ThemeResource VideoPlaceholderBrush}"/>
                                                <Image DataContextChanged="HistoryThumbnail_DataContextChanged"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch" />
                                                <ProgressBar Style="{StaticResource VideoWatchedProgressStyle}"
                                                             Value="{Binding WatchedPercent}"
                                                             Visibility="{Binding WatchedProgressVisibility}" />
                                                <Image Stretch="Fill"
                                                       IsHitTestVisible="False"
                                                       local:ThemeAsset.Path="Assets/rounding_up.png"/>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,4,4"
                                                        Padding="4,1"
                                                        CornerRadius="4"
                                                        Background="#D1000000">
                                                    <TextBlock Text="{Binding Duration}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                       FontSize="13"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding ChannelTitle}"
                                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Playlists -->
                    <Grid Margin="16,0,16,8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock x:Uid="Loc_Playlists_Text"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="PlaylistsList"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButtonStyle}"
                                        Height="90"
                                        Margin="16,0,16,12"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="PlaylistCard_Click">
                                    <Grid Height="90" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="144"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="144" Height="90"
                                              HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Width="126"
                                                    Height="70"
                                                    Margin="0,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding AccentBackColor}"
                                                    CornerRadius="8"
                                                    Opacity="0.72"/>
                                            <Border Width="136"
                                                    Height="75"
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding AccentFrontColor}"
                                                    CornerRadius="8"
                                                    Opacity="0.86"/>
                                            <Border Height="81"
                                                    VerticalAlignment="Bottom"
                                                    Background="{ThemeResource VideoPlaceholderBrush}"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Image local:ThumbnailImageLoader.SourceUrl="{Binding ThumbnailUrl}"
                                                           local:ThumbnailImageLoader.DecodeWidth="240"
                                                           Stretch="UniformToFill"/>
                                                    <Image Stretch="Fill"
                                                           IsHitTestVisible="False"
                                                           local:ThemeAsset.Path="Assets/rounding_up.png"/>
                                                </Grid>
                                            </Border>
                                            <Border Width="30"
                                                    Height="30"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,5,5"
                                                    CornerRadius="15"
                                                    Background="#B8000000">
                                                <Grid>
                                                    <Image Source="{Binding OverlayIconSource}"
                                                           Width="18"
                                                           Height="18"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="{Binding OverlayIconImageOpacity}"/>
                                                    <FontIcon Glyph="{Binding OverlayIconGlyph}"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="16"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Opacity="{Binding OverlayIconGlyphOpacity}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetadataText}"
                                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            Margin="0,2,0,12"
                            HorizontalAlignment="Stretch"
                            Click="DownloadsHeader_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/download.png"
                                   Width="23" Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="DownloadsHeaderText"
                                       Grid.Column="1"
                                       Margin="18,0,0,0"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <Image Grid.Column="2"
                                   local:ThemeAsset.Path="Assets/player/skip.png"
                                   Width="14" Height="14"
                                   Opacity="0.6"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <TextBlock x:Uid="Loc_NoData_Text" x:Name="EmptyText"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="22,40,22,0"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LoadingOverlay"
                  Background="{ThemeResource AppBackgroundBrush}"
                  Visibility="Collapsed">
                <local:AndroidLoadingRing x:Name="LoadingRing"
                                          Width="48"
                                          Height="48"
                                          IsActive="False"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <local:Tabbar x:Name="tabbar" Grid.Row="1" Canvas.ZIndex="20"/>

        <Grid x:Name="AccountsOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="100"
              Background="#80000000"
              Visibility="Collapsed"
              Tapped="AccountsOverlay_Tapped" />

        <local:BottomSheet x:Name="AccountsSheet"
                Grid.Row="0"
                Grid.RowSpan="2"
                Canvas.ZIndex="101"
                MaxHeight="520"
                Margin="10,0,10,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Visibility="Collapsed" OverlayElementName="AccountsOverlay" HandleHeight="36" HandlePointerPressed="AccountsDragArea_PointerPressed" HandlePointerMoved="AccountsDragArea_PointerMoved" HandlePointerReleased="AccountsDragArea_PointerReleased">
            <local:BottomSheet.RenderTransform>
                <TranslateTransform x:Name="AccountsSheetTransform" Y="540" />
            </local:BottomSheet.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                

                <TextBlock x:Name="AccountsSheetTitle"
                           Grid.Row="0"
                           Margin="20,0,20,12"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppPrimaryTextBrush}" />

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <ScrollViewer MaxHeight="350"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AccountsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="4,0,4,4"
                                            Padding="16,9"
                                            Height="68"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="AccountItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="42" Height="42"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <ImageBrush local:ThumbnailImageLoader.SourceUrl="{Binding ThumbnailUrl}"
                                                                local:ThumbnailImageLoader.DecodeWidth="240"
                                                                Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding ChannelHandle}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>

                                            <FontIcon Grid.Column="2"
                                                      Glyph="&#xE73E;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="18"
                                                      Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding SelectedVisibility}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <local:AndroidLoadingRing x:Name="AccountsLoadingRing"
                                              Width="38"
                                              Height="38"
                                              Margin="0,20"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsActive="False"
                                              Visibility="Collapsed" />

                    <TextBlock x:Name="AccountsEmptyText"
                               Margin="20,24"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                               Visibility="Collapsed" />
                </Grid>

            </Grid>
        </local:BottomSheet>
    </Grid>
</Page>
