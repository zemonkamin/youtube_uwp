<UserControl
    x:Class="YouTube.CustomShortsPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <UserControl.Resources>
        <Style x:Key="ShortsProgressSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#55FFFFFF"/>
            <Setter Property="Foreground" Value="#FF0033"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- Keep the same UWP Slider part layout as CustomVideoPlayer.
                             The thumb is present for RangeBase layout math, but invisible. -->
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="SliderContainer" Grid.Row="1">
                                <Grid x:Name="HorizontalTemplate" MinHeight="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>

                                    <Rectangle x:Name="HorizontalTrackRect"
                                               Fill="{TemplateBinding Background}"
                                               Height="5"
                                               Grid.Row="1"
                                               Grid.Column="2"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               RadiusX="0"
                                               RadiusY="0"/>

                                    <Rectangle x:Name="HorizontalDecreaseRect"
                                               Fill="{TemplateBinding Foreground}"
                                               Height="5"
                                               Grid.Row="1"
                                               Grid.Column="0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               RadiusX="0"
                                               RadiusY="0"/>

                                    <Thumb x:Name="HorizontalThumb"
                                           Grid.Row="0"
                                           Grid.RowSpan="3"
                                           Grid.Column="1"
                                           Width="1"
                                           Height="5"
                                           Opacity="0"
                                           AutomationProperties.AccessibilityView="Raw">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Rectangle Width="1" Height="5" Fill="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Black" SizeChanged="RootGrid_SizeChanged">
        <MediaPlayerElement x:Name="MediaPlayer"
                            AreTransportControlsEnabled="False"
                            Background="Black"
                            Stretch="UniformToFill"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsDoubleTapEnabled="False"/>

        <local:AndroidLoadingRing x:Name="LoadingRing"
                                  Width="36"
                                  Height="36"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsActive="False"
                                  Visibility="Collapsed"/>

        <TextBlock x:Name="ErrorMessageText"
                   Text=""
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="24"
                   Visibility="Collapsed"/>

        <!-- Subtitles, above the video and clear of the bottom slider / side actions. -->
        <Border x:Name="SubtitleOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#B0000000"
                CornerRadius="4"
                Padding="10,4"
                Margin="16,0,84,96"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SubtitleText"
                       Foreground="White"
                       FontSize="15"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid x:Name="ProgressSliderContainer"
              Height="30"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Margin="0">
            <Slider x:Name="ProgressSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Height="30"
                    Padding="0"
                    IsHitTestVisible="True"
                    IsTabStop="False"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    ManipulationMode="TranslateX"
                    ValueChanged="ProgressSlider_ValueChanged"
                    ManipulationStarted="ProgressSlider_ManipulationStarted"
                    ManipulationCompleted="ProgressSlider_ManipulationCompleted"
                    Style="{StaticResource ShortsProgressSliderStyle}"/>

            <!-- Full-width hit area. The visual slider has no visible thumb, so this layer
                 makes click-and-drag seeking reliable while keeping the bar flush to bottom. -->
            <Border x:Name="ProgressSliderHitArea"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tapped="ProgressSliderTrack_Tapped"
                    PointerPressed="ProgressSlider_PointerPressed"
                    PointerMoved="ProgressSlider_PointerMoved"
                    PointerReleased="ProgressSlider_PointerReleased"
                    PointerCanceled="ProgressSlider_PointerCanceled"
                    PointerCaptureLost="ProgressSlider_PointerCaptureLost"/>
        </Grid>
    </Grid>
</UserControl>
