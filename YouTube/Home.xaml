<Page
    x:Class="YouTube.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="CategoryChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same outlined pill foundation as the Accounts button on Me. -->
        <Style x:Key="OfflineDownloadsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="38" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Search Suggestions Section -->
        <Border x:Name="SuggestionsSection"
                Grid.Row="1"
                VerticalAlignment="Top"
                Background="{ThemeResource AppBackgroundBrush}"
                Visibility="Collapsed"
                Padding="16,8">
            <StackPanel>
                <TextBlock x:Uid="Loc_TrendingSearches_Text"
                           Foreground="White"
                           FontFamily="Roboto"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>
                <ListView x:Name="TrendingSuggestionsList"
                          Background="Transparent"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="TrendingItem_Click">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="48"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;"
                                         FontFamily="Segoe MDL2 Assets"
                                         FontSize="16"
                                         Foreground="{ThemeResource AppSecondaryTextBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding}"
                                          Foreground="{ThemeResource AppPrimaryTextBrush}"
                                          FontFamily="Roboto"
                                          FontSize="14"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center"
                                          TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Main content with ScrollViewer -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="0"
                      Grid.RowSpan="3"
                      Background="{ThemeResource AppBackgroundBrush}"
                      ZoomMode="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="ScrollViewer_ViewChanged">

            <StackPanel Background="{ThemeResource AppBackgroundBrush}"
                        Padding="0,56,0,52">

                <!-- Home category chips -->
                <Grid x:Name="CategoriesHost"
                      Background="{ThemeResource AppBackgroundBrush}"
                      Margin="0,0,0,8">
                    <ScrollViewer x:Name="CategoryPlaceholderScrollViewer"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="48"
                                  Visibility="Visible">
                        <StackPanel Orientation="Horizontal"
                                    Padding="12,6,12,6">
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="CategoryScrollViewer"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="48"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="CategoryChipsPanel"
                                    Orientation="Horizontal"
                                    Padding="12,6,12,6"/>
                    </ScrollViewer>
                </Grid>
                <!-- Video Cards Container -->
                <ItemsControl x:Name="RecommendationsList"
                             Background="{ThemeResource AppBackgroundBrush}"
                             HorizontalAlignment="Stretch"
                             Padding="8,8,8,16"
                             SizeChanged="CardsItemsControl_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" 
                                         ItemWidth="360"
                                         MaximumRowsOrColumns="3"
                                         HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButtonStyle}" Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Stretch"
                                   Tag="ResponsiveCard"
                                   Loaded="ResponsiveCard_Loaded"
                                   SizeChanged="ResponsiveCard_SizeChanged"
                                   Margin="0,0,0,16"
                                   Click="VideoCard_Click">
                                <StackPanel Orientation="Vertical" 
                                          Background="{ThemeResource AppBackgroundBrush}" 
                                          HorizontalAlignment="Stretch">
                                    <!-- Video Thumbnail -->
                                    <Grid SizeChanged="VideoThumbnailHost_SizeChanged"
                                          Tag="VideoCardThumbnailChrome">
                                        <Border Tag="VideoCardThumbnailChrome" Background="{ThemeResource VideoPlaceholderBrush}" />
                                        <Border Tag="VideoCardThumbnailChrome">
                                            <Grid>
                                                <Image DataContextChanged="CardThumbnail_DataContextChanged"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Stretch"
                                                       HorizontalAlignment="Stretch"/>
                                                <ProgressBar Style="{StaticResource VideoWatchedProgressStyle}"
                                                             Value="{Binding WatchedPercent}"
                                                             Visibility="{Binding WatchedProgressVisibility}" />
                                            </Grid>
                                        </Border>
                                        <!-- Duration overlay -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,8,8"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="#CC000000">
                                            <TextBlock Text="{Binding Duration}" 
                                                       Foreground="White" 
                                                       FontSize="12" 
                                                       FontWeight="Medium"/>
                                        </Border>
                                    </Grid>

                                    <!-- Title and Channel -->
                                    <Grid Tag="VideoCardMetadata" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Top">
                                            <Border Background="{ThemeResource AvatarPlaceholderBrush}" />
                                            <Image Stretch="UniformToFill"
                                                   DataContextChanged="ChannelIcon_DataContextChanged"
                                                   Loaded="ChannelIcon_Loaded" />
                                            <Image Stretch="Fill" IsHitTestVisible="False"
                                                   local:ThemeAsset.Path="Assets/rounding.png" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                     TextWrapping="NoWrap"
                                                     TextTrimming="CharacterEllipsis"
                                                     Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                     FontFamily="Roboto"
                                                     FontSize="14"
                                                     FontWeight="Medium"/>
                                            <TextBlock Text="{Binding MetadataLine}"
                                                     TextWrapping="NoWrap"
                                                     TextTrimming="CharacterEllipsis"
                                                     Foreground="{ThemeResource AppMutedTextBrush}"
                                                     FontFamily="Roboto"
                                                     FontSize="12"
                                                     Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Inline card placeholders used while switching category chips -->
                <ItemsControl x:Name="InlineSkeletonCardsList"
                              Background="{ThemeResource AppBackgroundBrush}"
                              HorizontalAlignment="Stretch"
                              Padding="8,8,8,16"
                              Visibility="Collapsed"
                              SizeChanged="CardsItemsControl_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="360"
                                           MaximumRowsOrColumns="3"
                                           HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16"
                                  HorizontalAlignment="Stretch"
                                  Tag="ResponsiveCard"
                                  Loaded="ResponsiveCard_Loaded"
                                  SizeChanged="PlaceholderCardHost_SizeChanged">
                                <Image local:ThemeAsset.Path="Assets/yt_skeleton/video.png"
                                       Stretch="Uniform"
                                       ImageOpened="PlaceholderCard_ImageOpened"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom Loading Indicator for infinite scroll -->
                <StackPanel x:Name="BottomLoadingPanel"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,40">
                    <local:AndroidLoadingRing x:Name="BottomLoadingRing"
                                              IsActive="False"
                                              Width="30"
                                              Height="30"/>
                    <TextBlock x:Uid="Loc_LoadingMoreVideos_Text"
                               Foreground="{ThemeResource AppMutedTextBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Skeleton Loading Screen -->
        <Grid x:Name="SkeletonLoader"
              Grid.Row="1"
              Background="{ThemeResource AppBackgroundBrush}"
              Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel Background="{ThemeResource AppBackgroundBrush}">
                    <ScrollViewer HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="56"
                                  Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal"
                                    Padding="12,6,12,6">
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                            <Border Width="112" Height="36" CornerRadius="9" Background="{ThemeResource AppSurfaceBrush}" Margin="0,0,8,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ItemsControl x:Name="SkeletonCardsList"
                              Background="{ThemeResource AppBackgroundBrush}"
                              HorizontalAlignment="Stretch"
                              Padding="8,8,8,16"
                              SizeChanged="CardsItemsControl_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="360"
                                           MaximumRowsOrColumns="3"
                                           HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16"
                                  HorizontalAlignment="Stretch"
                                  Tag="ResponsiveCard"
                                  Loaded="ResponsiveCard_Loaded"
                                  SizeChanged="PlaceholderCardHost_SizeChanged">
                                <Image local:ThemeAsset.Path="Assets/yt_skeleton/video.png"
                                       Stretch="Uniform"
                                       ImageOpened="PlaceholderCard_ImageOpened"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>



        <!-- Offline state -->
        <Grid x:Name="OfflinePanel"
              Grid.Row="1"
              Background="{ThemeResource AppBackgroundBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="32,0,32,42">
                <Image Source="Assets/failed_loading.png"
                       Width="170"
                       Height="170"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
                <TextBlock x:Uid="Loc_NoConnectionToTheInternet_Text"
                           Foreground="{ThemeResource AppPrimaryTextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock x:Uid="Loc_LooksLikeWeCanTLoadVideosForYou_Text"
                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="340"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>
                <Button x:Uid="Loc_TryAgain_Content" x:Name="OfflineShowListButton"
                        Click="RetryButton_Click"
                        Background="#3EA6FF"
                        Foreground="{ThemeResource PrimaryActionForegroundBrush}"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Padding="18,8"
                        MinWidth="150"
                        HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="22"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="OfflineDownloadsButton"
                        Style="{StaticResource OfflineDownloadsButtonStyle}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Click="OfflineDownloadsButton_Click">
                    <TextBlock x:Name="OfflineDownloadsButtonText"
                               Foreground="{ThemeResource AppPrimaryTextBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Center loading ring used while switching category chips -->
        <Grid Grid.Row="1"
              IsHitTestVisible="False">
            <local:AndroidLoadingRing x:Name="HomeLoadingRing"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      Width="42"
                                      Height="42"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
        </Grid>

        <!-- Keep navigation chrome last in the visual tree so BackdropBrush always
             samples the scrolling Home content below it. -->
        <local:Navbar x:Name="navbar" Grid.Row="0" Canvas.ZIndex="20"/>
        <local:Tabbar x:Name="tabbar" Grid.Row="2" Canvas.ZIndex="20"/>
    </Grid>
</Page>
