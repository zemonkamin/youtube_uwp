<Page
    x:Class="YouTube.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <local:Navbar x:Name="navbar" Grid.Row="0" />

        <Grid Grid.Row="1" Background="{ThemeResource AppBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ZoomMode="Disabled">
                <StackPanel Padding="0,12,0,82">
                    <TextBlock x:Uid="Loc_Settings_Text"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="18,0,18,22" />

                    <TextBlock x:Uid="Loc_Account_Text"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="18,0,18,10" />

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="LogoutButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/log_out.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Uid="Loc_LogOut_Text" Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                        </Grid>
                    </Button>

                    <TextBlock x:Uid="SettingsLanguageSection"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="18,22,18,10" />

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="LanguageButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/languages.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Uid="SettingsLanguageLabel"
                                       Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock x:Name="LanguageValueText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Image local:ThemeAsset.Path="Assets/player/skip.png"
                                       Width="14"
                                       Height="14"
                                       Stretch="Uniform"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock x:Name="AppearanceSectionText"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="18,22,18,10" />

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="ThemeButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/theme.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="ThemeLabelText"
                                       Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock x:Name="ThemeValueText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Image local:ThemeAsset.Path="Assets/player/skip.png"
                                       Width="14"
                                       Height="14"
                                       Stretch="Uniform"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="LiveTileToggleButton"
                            Style="{StaticResource SettingsIconButtonStyle}"
                            Height="62"
                            HorizontalAlignment="Stretch"
                            Click="LiveTileToggleButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/live_tile.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="18,0,12,0">
                                <TextBlock x:Name="LiveTileLabelText"
                                           Foreground="{ThemeResource AppPrimaryTextBrush}"
                                           FontSize="16" />
                                <TextBlock x:Name="LiveTileDescriptionText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="2"
                                  Width="46"
                                  Height="26"
                                  VerticalAlignment="Center">
                                <Border x:Name="LiveTileToggleTrack"
                                        Width="46"
                                        Height="26"
                                        Background="Transparent"
                                        CornerRadius="13" />
                                <Ellipse Width="20"
                                         Height="20"
                                         Fill="{ThemeResource ToggleKnobBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="3,3,0,3">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="LiveTileToggleThumbTransform" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Button>

                    <TextBlock x:Uid="Loc_Video_Text"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="18,22,18,10" />

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="PreferredQualityButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/player/quality.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Uid="Loc_PreferredVideoQuality_Text" Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock x:Uid="Loc_Auto_Text" x:Name="PreferredQualityValueText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Image local:ThemeAsset.Path="Assets/player/skip.png"
                                       Width="14"
                                       Height="14"
                                       Stretch="Uniform"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="PreferredShortsQualityButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/player/quality.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Uid="Loc_PreferredShortsQuality_Text" Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock x:Uid="Loc_Auto_Text" x:Name="PreferredShortsQualityValueText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Image local:ThemeAsset.Path="Assets/player/skip.png"
                                       Width="14"
                                       Height="14"
                                       Stretch="Uniform"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>


                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="ThumbnailQualityButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/player/quality.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="ThumbnailQualityLabelText"
                                       Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock x:Name="ThumbnailQualityValueText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Image local:ThemeAsset.Path="Assets/player/skip.png"
                                       Width="14"
                                       Height="14"
                                       Stretch="Uniform"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="ScrubPreviewToggleButton"
                            Style="{StaticResource SettingsIconButtonStyle}"
                            Height="58"
                            HorizontalAlignment="Stretch"
                            Click="ScrubPreviewToggleButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock x:Uid="Loc_SeekPreview_Text"
                                           Foreground="{ThemeResource AppPrimaryTextBrush}"
                                           FontSize="16" />
                                <TextBlock x:Uid="Loc_ShowVideoThumbnailWhileSeeking_Text"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  Width="46"
                                  Height="26"
                                  VerticalAlignment="Center">
                                <Border x:Name="ScrubPreviewToggleTrack"
                                        Width="46"
                                        Height="26"
                                        Background="{ThemeResource AppMutedTextBrush}"
                                        CornerRadius="13" />
                                <Ellipse Width="20"
                                         Height="20"
                                         Fill="{ThemeResource ToggleKnobBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="3,3,0,3">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ScrubPreviewToggleThumbTransform"
                                                            X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Button>

                    <Button x:Name="AutoFullscreenLandscapeToggleButton"
                            Style="{StaticResource SettingsIconButtonStyle}"
                            Height="58"
                            HorizontalAlignment="Stretch"
                            Click="AutoFullscreenLandscapeToggleButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                <TextBlock x:Uid="Loc_AutoFullscreenInLandscape_Text"
                                           Foreground="{ThemeResource AppPrimaryTextBrush}"
                                           FontSize="16" />
                                <TextBlock x:Uid="Loc_ExpandTheVideoWhenThePhoneRotates_Text"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  Width="46"
                                  Height="26"
                                  VerticalAlignment="Center">
                                <Border x:Name="AutoFullscreenLandscapeToggleTrack"
                                        Width="46"
                                        Height="26"
                                        Background="{ThemeResource PrimaryActionBackgroundBrush}"
                                        CornerRadius="13" />
                                <Ellipse Width="20"
                                         Height="20"
                                         Fill="{ThemeResource ToggleKnobBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="3,3,0,3">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="AutoFullscreenLandscapeToggleThumbTransform"
                                                            X="20" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Button>



                    <TextBlock x:Uid="Loc_Notifications_Text"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="18,22,18,10" />

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="NotificationsButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/notifications.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Uid="Loc_Notifications_Text" Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock x:Uid="Loc_EveryHour_Text" x:Name="NotificationFrequencyValueText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Image local:ThemeAsset.Path="Assets/player/skip.png"
                                       Width="14"
                                       Height="14"
                                       Stretch="Uniform"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock x:Uid="Loc_About_Text"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="18,22,18,10" />

                    <Button Style="{StaticResource SettingsIconButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Click="AboutButton_Click">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   local:ThemeAsset.Path="Assets/info.png"
                                   Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Uid="Loc_Information_Text" Grid.Column="1"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                            <Image Grid.Column="2"
                                   local:ThemeAsset.Path="Assets/player/skip.png"
                                   Width="14"
                                   Height="14"
                                   Stretch="Uniform"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="OverlayGrid"
                  Background="#80000000"
                  Visibility="Collapsed"
                  Tapped="OverlayGrid_Tapped" />

            <Border x:Name="QualityBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppDividerBrush}"
                    CornerRadius="15"
                    Height="330"
                    Margin="10,0,10,10"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="QualityBottomSheetTransform" Y="340" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Height="34"
                          Background="Transparent"
                          Tapped="QualityDragArea_Tapped"
                          PointerPressed="QualityDragArea_PointerPressed"
                          PointerMoved="QualityDragArea_PointerMoved"
                          PointerReleased="QualityDragArea_PointerReleased"
                          PointerCaptureLost="QualityDragArea_PointerReleased">
                        <Rectangle Width="38"
                                   Height="4"
                                   Fill="Gray"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <StackPanel>
                            <TextBlock x:Name="QualitySheetTitleText"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,0,0,12" />
                            <StackPanel x:Name="QualityOptionsPanel" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LanguageBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppDividerBrush}"
                    CornerRadius="15"
                    Height="420"
                    Margin="10,0,10,10"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LanguageBottomSheetTransform" Y="430" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Height="34"
                          Background="Transparent"
                          Tapped="LanguageDragArea_Tapped"
                          PointerPressed="LanguageDragArea_PointerPressed"
                          PointerMoved="LanguageDragArea_PointerMoved"
                          PointerReleased="LanguageDragArea_PointerReleased"
                          PointerCaptureLost="LanguageDragArea_PointerReleased">
                        <Rectangle Width="38"
                                   Height="4"
                                   Fill="Gray"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   x:Uid="SettingsLanguageSheetTitle"
                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,0,0,12" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Enabled">
                            <StackPanel x:Name="LanguageOptionsPanel" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ThemeBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppDividerBrush}"
                    CornerRadius="15"
                    Height="230"
                    Margin="10,0,10,10"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThemeBottomSheetTransform" Y="240" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Height="34"
                          Background="Transparent"
                          Tapped="ThemeDragArea_Tapped"
                          PointerPressed="ThemeDragArea_PointerPressed"
                          PointerMoved="ThemeDragArea_PointerMoved"
                          PointerReleased="ThemeDragArea_PointerReleased"
                          PointerCaptureLost="ThemeDragArea_PointerReleased">
                        <Rectangle Width="38"
                                   Height="4"
                                   Fill="Gray"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <StackPanel>
                            <TextBlock x:Name="ThemeSheetTitleText"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,0,0,12" />
                            <StackPanel x:Name="ThemeOptionsPanel" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="NotificationsBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppDividerBrush}"
                    CornerRadius="15"
                    Height="370"
                    Margin="10,0,10,10"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NotificationsBottomSheetTransform" Y="380" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Height="34"
                          Background="Transparent"
                          Tapped="NotificationsDragArea_Tapped"
                          PointerPressed="NotificationsDragArea_PointerPressed"
                          PointerMoved="NotificationsDragArea_PointerMoved"
                          PointerReleased="NotificationsDragArea_PointerReleased"
                          PointerCaptureLost="NotificationsDragArea_PointerReleased">
                        <Rectangle Width="38"
                                   Height="4"
                                   Fill="Gray"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <StackPanel>
                            <TextBlock x:Uid="Loc_Notifications_Text"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,0,0,12" />

                            <Grid Height="48" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="Loc_SendNotifications_Text"
                                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                                               FontSize="14" />
                                    <TextBlock x:Uid="Loc_BackgroundToastsFromYouTubeNotifications_Text"
                                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                                               FontSize="12"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="NotificationsToggleButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SettingsIconButtonStyle}"
                                        Width="56"
                                        Height="32"
                                        Click="NotificationsToggleButton_Click">
                                    <Grid Width="56" Height="32">
                                        <Border x:Name="NotificationsToggleTrack"
                                                Width="56"
                                                Height="32"
                                                Background="{ThemeResource AppMutedTextBrush}"
                                                CornerRadius="16" />
                                        <Ellipse x:Name="NotificationsToggleThumb"
                                                 Width="24"
                                                 Height="24"
                                                 Fill="{ThemeResource ToggleKnobBrush}"
                                                 HorizontalAlignment="Left"
                                                 Margin="4,4,0,4">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform x:Name="NotificationsToggleThumbTransform" X="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Button>
                            </Grid>

                            <TextBlock x:Uid="Loc_Frequency_Text"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,8" />
                            <StackPanel x:Name="NotificationFrequencyOptionsPanel" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="AboutBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppSurfaceAltBrush}"
                    CornerRadius="15"
                    Height="250"
                    Margin="10,0,10,10"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AboutBottomSheetTransform" Y="260" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Height="34"
                          Background="Transparent"
                          Tapped="AboutDragArea_Tapped"
                          PointerPressed="AboutDragArea_PointerPressed"
                          PointerMoved="AboutDragArea_PointerMoved"
                          PointerReleased="AboutDragArea_PointerReleased"
                          PointerCaptureLost="AboutDragArea_PointerReleased">
                        <Rectangle Width="38"
                                   Height="4"
                                   Fill="Gray"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <StackPanel>
                            <TextBlock x:Uid="Loc_Information_Text"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <TextBlock x:Name="AboutText"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <local:Tabbar x:Name="tabbar" Grid.Row="2" />
    </Grid>
</Page>
