<Page
    x:Class="YouTube.Subscriptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <!-- Button style without pressed/hover states -->
        <Style x:Key="ChannelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Navbar at the top -->
        <local:Navbar x:Name="navbar" Grid.Row="0"/>

        <!-- Content area with both subscriptions and videos -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Horizontal scrolling area for subscriptions -->
                <ScrollViewer x:Name="SubscriptionsScrollViewer" 
                              HorizontalScrollMode="Enabled" 
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollMode="Disabled"
                              Margin="0,10,0,20"
                              Height="120">
                    <StackPanel x:Name="SubscriptionsPanel" 
                                Orientation="Horizontal" 
                                Padding="16,0,16,0"/>
                </ScrollViewer>

                <!-- Videos area -->
                <ItemsControl x:Name="VideosItemsControl"
                             Background="{ThemeResource AppBackgroundBrush}"
                             HorizontalAlignment="Stretch"
                             Padding="8,0,8,16"
                             SizeChanged="CardsItemsControl_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" 
                                         ItemWidth="360"
                                         MaximumRowsOrColumns="3"
                                         HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButtonStyle}" Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Stretch"
                                   Margin="0,0,0,16"
                                   Loaded="ResponsiveCard_Loaded"
                                   SizeChanged="ResponsiveCard_SizeChanged"
                                   Click="VideoCard_Click"
                                   Tag="{Binding}">
                                <StackPanel Orientation="Vertical" 
                                          Background="{ThemeResource AppBackgroundBrush}" 
                                          HorizontalAlignment="Stretch">
                                    <!-- Video Thumbnail -->
                                    <Grid SizeChanged="VideoThumbnailHost_SizeChanged"
                                          Tag="VideoCardThumbnailChrome">
                                        <Border Tag="VideoCardThumbnailChrome" Background="{ThemeResource AppSurfaceAltBrush}" CornerRadius="8" />
                                        <Border Tag="VideoCardThumbnailChrome" CornerRadius="8">
                                            <Image DataContextChanged="CardThumbnail_DataContextChanged"
                                                   Stretch="UniformToFill"
                                                   VerticalAlignment="Stretch"
                                                   HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <!-- Duration overlay -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,8,8"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="#CC000000">
                                            <TextBlock Text="{Binding Duration}" 
                                                       Foreground="White" 
                                                       FontSize="12" 
                                                       FontWeight="Medium"/>
                                        </Border>
                                    </Grid>

                                    <!-- Title and Channel -->
                                    <Grid Tag="VideoCardMetadata" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Top">
                                            <Border Background="{ThemeResource AvatarPlaceholderBrush}" />
                                            <Image Stretch="UniformToFill"
                                                   DataContextChanged="ChannelIcon_DataContextChanged"
                                                   Loaded="ChannelIcon_Loaded" />
                                            <Image Stretch="Fill" IsHitTestVisible="False"
                                                   local:ThemeAsset.Path="Assets/rounding.png" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                     TextWrapping="NoWrap"
                                                     TextTrimming="CharacterEllipsis"
                                                     Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                     FontSize="14"/>
                                            <TextBlock Text="{Binding ChannelTitle}"
                                                     Foreground="{ThemeResource AppMutedTextBrush}"
                                                     FontSize="12"
                                                     Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid x:Name="VideosSkeletonLoader"
                      Visibility="Collapsed">
                    <ItemsControl x:Name="VideosSkeletonCardsList"
                              Background="{ThemeResource AppBackgroundBrush}"
                              HorizontalAlignment="Stretch"
                              Padding="8,0,8,16"
                              SizeChanged="CardsItemsControl_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="360"
                                           MaximumRowsOrColumns="3"
                                           HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16"
                                  HorizontalAlignment="Stretch"
                                  Tag="ResponsiveCard"
                                  Loaded="ResponsiveCard_Loaded"
                                  SizeChanged="PlaceholderCardHost_SizeChanged">
                                <Image local:ThemeAsset.Path="Assets/yt_skeleton/video.png"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       ImageOpened="PlaceholderCard_ImageOpened"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Tabbar at the bottom -->
        <local:Tabbar x:Name="tabbar" Grid.Row="2"/>
        
        <!-- Loading indicator -->
        <Grid Grid.Row="1">
            <local:AndroidLoadingRing x:Name="LoadingRing"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      Width="32"
                                      Height="32"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
