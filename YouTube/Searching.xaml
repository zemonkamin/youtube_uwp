<Page
    x:Class="YouTube.Searching"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <!-- The search field owns its pill background.  This replaces the old
             separate Border behind a transparent TextBox and keeps the visual
             identical without relying on the platform TextBox chrome. -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0,40,0" />
            <Setter Property="Background" Value="{ThemeResource AppDividerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Roboto" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Border.CornerRadius exists from the original Windows 10
                                 UWP contract (10240), so the rounded search field also works
                                 on Windows 10 Mobile.  The Border is the TextBox chrome itself,
                                 not a separate element placed behind the TextBox. -->
                            <Border x:Name="SearchBoxBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="20">
                                <Grid>
                                    <ScrollViewer x:Name="ContentElement"
                                                  Padding="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollMode="Auto"
                                                  VerticalScrollMode="Disabled"
                                                  ZoomMode="Disabled"
                                                  IsTabStop="False" />

                                    <TextBlock x:Name="PlaceholderTextContentPresenter"
                                               Padding="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Text="{TemplateBinding PlaceholderText}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No system PointerOver/Pressed animation or background flash. -->
        <Style x:Key="FlatIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Height="64"
            Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>



            <Grid
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center">
                <TextBox x:Uid="Loc_SearchYouTube_PlaceholderText"
                    x:Name="SearchInput"
                    Style="{StaticResource SearchTextBoxStyle}"
                    VerticalAlignment="Center"
                    KeyUp="SearchInput_KeyUp"
                    TextChanged="SearchInput_TextChanged" />

                <Button
                    x:Name="ClearButton"
                    Style="{StaticResource FlatIconButtonStyle}"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="ClearButton_Click"
                    Content="&#xE106;"
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="{ThemeResource AppPrimaryTextBrush}"
                    Visibility="Collapsed" />
            </Grid>

            <Button
                x:Name="VoiceButton"
                Grid.Column="2"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{ThemeResource AppMutedTextBrush}"
                IsHitTestVisible="False"
                Opacity="0.45">
                <Image
                    Width="24"
                    Height="24"
                    local:ThemeAsset.Path="Assets/microphone.png"
                    Stretch="Uniform" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                x:Name="SearchHistoryListView"
                Padding="0,10"
                IsItemClickEnabled="True"
                ItemClick="SuggestionsListView_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="52" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                local:ThemeAsset.Path="Assets/player/replay.png"
                                Stretch="Uniform" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                Foreground="{ThemeResource AppPrimaryTextBrush}"
                                Text="{Binding SearchText}"
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                Grid.Column="2"
                                Width="48"
                                Height="48"
                                Click="RemoveHistoryItem_Click"
                                Content="&#xE106;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{ThemeResource AppPrimaryTextBrush}"
                                Style="{StaticResource FlatIconButtonStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                x:Name="SuggestionsListView"
                Padding="0,10"
                IsItemClickEnabled="True"
                ItemClick="SuggestionsListView_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="52" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                local:ThemeAsset.Path="Assets/search.png"
                                Stretch="Uniform" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                Foreground="{ThemeResource AppPrimaryTextBrush}"
                                Text="{Binding}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</Page>