<Page
    x:Class="YouTube.Searching"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Height="64"
            Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>



            <Grid
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center">
                <Border
                    Height="40"
                    Background="{ThemeResource AppDividerBrush}"
                    CornerRadius="20" />

                <TextBox
                    x:Name="SearchInput"
                    Padding="16,0,40,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Roboto"
                    FontSize="16"
                    Foreground="{ThemeResource AppPrimaryTextBrush}"
                    KeyUp="SearchInput_KeyUp"
                    PlaceholderText="Search YouTube"
                    TextChanged="SearchInput_TextChanged" Margin="0,0,0,-14"  />

                <Button
                    x:Name="ClearButton"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Content="&#xE106;"
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                    Visibility="Collapsed" />
            </Grid>

            <Button
                x:Name="VoiceButton"
                Grid.Column="2"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{ThemeResource AppMutedTextBrush}"
                IsHitTestVisible="False"
                Opacity="0.45">
                <Image
                    Width="24"
                    Height="24"
                    local:ThemeAsset.Path="Assets/microphone.png"
                    Stretch="Uniform" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                x:Name="SearchHistoryListView"
                Padding="0,10"
                IsItemClickEnabled="True"
                ItemClick="SuggestionsListView_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="52" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                Glyph="&#xE81C;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                Foreground="{ThemeResource AppPrimaryTextBrush}"
                                Text="{Binding SearchText}"
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                Grid.Column="2"
                                Width="48"
                                Height="48"
                                Background="Transparent"
                                Click="RemoveHistoryItem_Click"
                                Content="&#xE106;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Style="{StaticResource TextBlockButtonStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                x:Name="SuggestionsListView"
                Padding="0,10"
                IsItemClickEnabled="True"
                ItemClick="SuggestionsListView_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="52" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                Glyph="&#xE721;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                Foreground="{ThemeResource AppPrimaryTextBrush}"
                                Text="{Binding}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</Page>