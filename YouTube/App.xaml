<Application
    x:Class="YouTube.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppBackgroundColor">#0F0F0F</Color>
                    <Color x:Key="AppSurfaceColor">#272727</Color>
                    <Color x:Key="AppSurfaceAltColor">#1A1A1A</Color>
                    <Color x:Key="AppSurfaceHoverColor">#222222</Color>
                    <Color x:Key="AppPrimaryTextColor">#FFFFFF</Color>
                    <Color x:Key="LoadingRingColor">#FFFFFF</Color>
                    <Color x:Key="AppSecondaryTextColor">#AAAAAA</Color>
                    <Color x:Key="AppMutedTextColor">#888888</Color>
                    <Color x:Key="AppDividerColor">#222222</Color>
                    <Color x:Key="NavbarSearchBorderColor">#303030</Color>
                    <Color x:Key="VideoPlaceholderColor">#000000</Color>
                    <Color x:Key="AvatarPlaceholderColor">#333333</Color>
                    <Color x:Key="ToggleKnobColor">#202124</Color>
                    <Color x:Key="PrimaryActionBackgroundColor">#F1F1F1</Color>
                    <Color x:Key="PrimaryActionForegroundColor">#0F0F0F</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="AppSurfaceColor">#F2F2F2</Color>
                    <Color x:Key="AppSurfaceAltColor">#F7F7F7</Color>
                    <Color x:Key="AppSurfaceHoverColor">#E8E8E8</Color>
                    <Color x:Key="AppPrimaryTextColor">#0F0F0F</Color>
                    <Color x:Key="LoadingRingColor">#000000</Color>
                    <Color x:Key="AppSecondaryTextColor">#606060</Color>
                    <Color x:Key="AppMutedTextColor">#777777</Color>
                    <Color x:Key="AppDividerColor">#E5E5E5</Color>
                    <Color x:Key="NavbarSearchBorderColor">#777777</Color>
                    <Color x:Key="VideoPlaceholderColor">#CECECE</Color>
                    <Color x:Key="AvatarPlaceholderColor">#D9D9D9</Color>
                    <Color x:Key="ToggleKnobColor">#FFFFFF</Color>
                    <Color x:Key="PrimaryActionBackgroundColor">#0F0F0F</Color>
                    <Color x:Key="PrimaryActionForegroundColor">#FFFFFF</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{ThemeResource AppSurfaceAltColor}" />
            <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="{ThemeResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="{ThemeResource AppPrimaryTextColor}" />
            <SolidColorBrush x:Key="LoadingRingBrush" Color="{ThemeResource LoadingRingColor}" />
            <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{ThemeResource AppSecondaryTextColor}" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="{ThemeResource AppMutedTextColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{ThemeResource AppDividerColor}" />
            <SolidColorBrush x:Key="NavbarSearchBorderBrush" Color="{ThemeResource NavbarSearchBorderColor}" />
            <SolidColorBrush x:Key="VideoPlaceholderBrush" Color="{ThemeResource VideoPlaceholderColor}" />
            <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="{ThemeResource AvatarPlaceholderColor}" />
            <SolidColorBrush x:Key="ToggleKnobBrush" Color="{ThemeResource ToggleKnobColor}" />
            <SolidColorBrush x:Key="PrimaryActionBackgroundBrush" Color="{ThemeResource PrimaryActionBackgroundColor}" />
            <SolidColorBrush x:Key="PrimaryActionForegroundBrush" Color="{ThemeResource PrimaryActionForegroundColor}" />

            <!-- Same circular semi-transparent chrome as CustomVideoPlayer.ControlButtonStyle,
                 exposed at application scope so the code-created mini-player can reuse it. -->
            <Style x:Key="MiniPlayerControlButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#66000000" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="{TemplateBinding Background}" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Desktop CompactOverlay seek bar: same lightweight geometry as the normal player,
                 but uses the user's Windows accent color instead of the fixed YouTube red. -->
            <Style x:Key="DesktopMiniPlayerSliderStyle" TargetType="Slider">
                <Setter Property="Background" Value="#666666"/>
                <Setter Property="Foreground" Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="SliderContainer" Grid.Row="1">
                                    <Grid x:Name="HorizontalTemplate" MinHeight="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle Fill="{TemplateBinding Background}"
                                                   Height="4"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="3"
                                                   HorizontalAlignment="Stretch"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   IsHitTestVisible="False"/>
                                        <Rectangle x:Name="HorizontalTrackRect"
                                                   Fill="{TemplateBinding Background}"
                                                   Height="4"
                                                   Grid.Row="1"
                                                   Grid.Column="2"
                                                   HorizontalAlignment="Stretch"
                                                   RadiusX="2"
                                                   RadiusY="2"/>
                                        <Rectangle x:Name="HorizontalDecreaseRect"
                                                   Fill="{TemplateBinding Foreground}"
                                                   Height="4"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   HorizontalAlignment="Stretch"
                                                   RadiusX="2"
                                                   RadiusY="2"/>
                                        <Rectangle Fill="{TemplateBinding Foreground}"
                                                   Height="4"
                                                   Width="8"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   HorizontalAlignment="Left"
                                                   IsHitTestVisible="False"/>
                                        <Rectangle Fill="{TemplateBinding Background}"
                                                   Height="4"
                                                   Width="8"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   IsHitTestVisible="False"/>
                                        <Thumb x:Name="HorizontalThumb"
                                               Grid.Row="0"
                                               Grid.RowSpan="3"
                                               Grid.Column="1"
                                               Height="16"
                                               Width="16"
                                               AutomationProperties.AccessibilityView="Raw">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <Ellipse Fill="{ThemeResource SystemControlHighlightAccentBrush}"
                                                             Width="16"
                                                             Height="16"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="local:BottomSheet">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceAltBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="HandleHeight" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:BottomSheet">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="PART_DragArea"
                                          Grid.Row="0"
                                          Height="24"
                                          Background="Transparent">
                                        <Rectangle Width="40"
                                                   Height="4"
                                                   Fill="Gray"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Margin="0,10,0,0" />
                                    </Grid>
                                    <ContentPresenter Grid.Row="1"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="VideoWatchedProgressStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Foreground" Value="#FFFF0033" />
                <Setter Property="Background" Value="#FF4A4A4A" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <FontFamily x:Key="RobotoFont">/Assets/Roboto.ttf#Roboto</FontFamily>
            <FontFamily x:Key="CommentFont">ms-appx:///Assets/Roboto-Regular.ttf#Roboto</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RobotoFont}"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource RobotoFont}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource RobotoFont}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonContent"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  x:Name="ButtonContent"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ShortsNoPressButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
