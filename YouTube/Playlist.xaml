<Page
    x:Class="YouTube.Playlist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F0F0F">

    <Grid Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- Top bar: search only. Back navigation uses the system back button. -->
        <Grid Grid.Row="0" Background="#0F0F0F" Padding="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Width="48"
                    Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10"
                    Click="SearchButton_Click">
                <Image Source="Assets/search.png"
                       Width="28"
                       Height="28"
                       Stretch="Uniform" />
            </Button>
        </Grid>

        <Grid x:Name="LoadingGrid" Grid.Row="1" Background="#0F0F0F" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:AndroidLoadingRing x:Name="LoadingRing" Width="48" Height="48" IsActive="True" />
                <TextBlock Text="Loading playlist..."
                           Foreground="#AAAAAA"
                           FontSize="14"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ErrorPanel" Grid.Row="1" Background="#0F0F0F" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <FontIcon Glyph="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="#AAAAAA" FontSize="42" />
                <TextBlock x:Name="ErrorText"
                           Text="Could not load playlist"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,16,0,8" />
                <TextBlock Text="Check your connection and try again"
                           Foreground="#AAAAAA"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,20" />
                <Button Content="Retry"
                        Click="RetryButton_Click"
                        Background="White"
                        Foreground="#0F0F0F"
                        BorderThickness="0"
                        Padding="24,10" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="MainContent"
                      Grid.Row="1"
                      Background="#0F0F0F"
                      Visibility="Collapsed"
                      ZoomMode="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="MainContent_ViewChanged">
            <StackPanel Background="#0F0F0F" Padding="0,8,0,24">

                <!-- Playlist header, like the mobile playlist screen, but without Play all / Save / Share / menu buttons. -->
                <Grid Margin="16,0,16,0">
                    <Border x:Name="PlaylistHeaderImageBorder" Height="185" CornerRadius="12" Background="#1F1F1F" />
                    <Border Height="185" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#11000000" Offset="0" />
                                <GradientStop Color="#AA000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel x:Name="PlaylistInfoPanel" Margin="16,14,16,14">
                    <TextBlock x:Name="PlaylistTitleText"
                               Text="Playlist"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold"
                               TextWrapping="WrapWholeWords"
                               MaxLines="3" />

                    <StackPanel x:Name="OwnerRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Ellipse x:Name="OwnerAvatarEllipse"
                                 Width="30"
                                 Height="30"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                        <TextBlock x:Name="OwnerText"
                                   Text=""
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="PlaylistMetaText"
                               Text=""
                               Foreground="#DDDDDD"
                               FontSize="15"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <TextBlock x:Name="PlaylistDescriptionText"
                               Text=""
                               Foreground="White"
                               FontSize="15"
                               TextWrapping="Wrap"
                               TextTrimming="WordEllipsis"
                               MaxLines="3"
                               Margin="0,12,0,0" />
                </StackPanel>

                <!-- Video cards: same layout as Channel/Home. -->
                <ItemsControl x:Name="VideosItemsControl"
                              SizeChanged="VideosItemsControl_SizeChanged"
                              Background="#0F0F0F"
                              HorizontalAlignment="Stretch"
                              Padding="8,8,8,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="360"
                                           MaximumRowsOrColumns="3"
                                           HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="8,0,8,16"
                                    Tag="ResponsiveCard"
                                    Loaded="ResponsiveCard_Loaded"
                                    SizeChanged="ResponsiveCard_SizeChanged"
                                    Click="VideoCard_Click">
                                <StackPanel Orientation="Vertical"
                                            Background="#0F0F0F"
                                            HorizontalAlignment="Stretch">
                                    <Grid SizeChanged="VideoThumbnailHost_SizeChanged"
                                          CornerRadius="8">
                                        <Border Background="#1A1A1A" CornerRadius="8" />
                                        <Border CornerRadius="8">
                                            <Image DataContextChanged="CardThumbnail_DataContextChanged"
                                                   Stretch="UniformToFill"
                                                   VerticalAlignment="Stretch"
                                                   HorizontalAlignment="Stretch" />
                                        </Border>
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,8,8"
                                                Padding="6,2">
                                            <Border.Background>
                                                <SolidColorBrush Color="Black" Opacity="0.8" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding Duration}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="Medium" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Margin="12,12,12,0">
                                        <TextBlock Text="{Binding Title}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="White"
                                                   FontFamily="Roboto"
                                                   FontSize="14"
                                                   FontWeight="Medium" />
                                        <TextBlock Text="{Binding ChannelTitle}"
                                                   Foreground="Gray"
                                                   FontFamily="Roboto"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="LoadingMorePanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="16,4,16,18">
                    <local:AndroidLoadingRing x:Name="LoadingMoreRing"
                                              Width="32"
                                              Height="32"
                                              IsActive="False" />
                    <TextBlock Text="Loading more..."
                               Foreground="#AAAAAA"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="EmptyText"
                           Text="No videos in this playlist"
                           Foreground="#AAAAAA"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="16,22,16,0" />
            </StackPanel>
        </ScrollViewer>

        <local:Tabbar x:Name="tabbar" Grid.Row="2" />
    </Grid>
</Page>
