<Page
    x:Class="YouTube.Navbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="NavbarSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="44,0,44,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Roboto" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ScrollViewer x:Name="ContentElement"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollMode="Auto"
                                          VerticalScrollMode="Disabled"
                                          ZoomMode="Disabled"
                                          IsTabStop="False" />
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Padding="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding PlaceholderText}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavbarFlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavbarSearchListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Border x:Name="NavbarGlassHost"
                Background="Transparent"
                IsHitTestVisible="False" />

        <!-- Programmatic focus target used to remove the caret without stealing focus from
             another control selected by the user. It is never reachable by keyboard/pointer. -->
        <Button x:Name="SearchFocusSink"
                Width="1"
                Height="1"
                Opacity="0"
                IsTabStop="False"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

        <Grid x:Name="VerticalLayout" Visibility="Visible">
            <Grid x:Name="TopBar" Background="Transparent" Height="56" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="YouTubeLogo"
                       local:ThemeAsset.Path="Assets/ytlogo.png"
                       Height="32"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Tapped="YouTubeLogo_Tapped" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button x:Name="NotificationsButtonVertical"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="NotificationsButton_Click"
                            VerticalAlignment="Center"
                            Padding="8"
                            Margin="0,0,4,0"
                            Visibility="Collapsed">
                        <Image local:ThemeAsset.Path="Assets/notifications.png" Width="24" Height="24" />
                    </Button>
                    <Button x:Name="ShowSearchButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ShowSearchButton_Click"
                            VerticalAlignment="Center"
                            Padding="8">
                        <Image local:ThemeAsset.Path="Assets/search.png" Width="24" Height="24" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="HorizontalLayout"
              Visibility="Collapsed"
              Height="56"
              VerticalAlignment="Top"
              Background="Transparent">
            <Image x:Name="HorizontalYouTubeLogo"
                   local:ThemeAsset.Path="Assets/ytlogo.png"
                   Height="32"
                   Margin="16,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Tapped="YouTubeLogo_Tapped" />

            <Grid x:Name="CenteredSearchHost"
                  Width="700"
                  Height="44"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="VoiceColumn" Width="48" />
                </Grid.ColumnDefinitions>

                <Border x:Name="CenteredSearchBar"
                        Grid.Column="0"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{ThemeResource NavbarSearchBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Uid="Loc_SearchYouTube_PlaceholderText"
                                 x:Name="SearchInputHorizontal"
                                 Grid.Column="0"
                                 Style="{StaticResource NavbarSearchTextBoxStyle}"
                                 KeyUp="SearchInputHorizontal_KeyUp"
                                 TextChanged="SearchInputHorizontal_TextChanged"
                                 GotFocus="SearchInputHorizontal_GotFocus"
                                 LostFocus="SearchInputHorizontal_LostFocus" />

                        <Image Grid.Column="0"
                               Width="19"
                               Height="19"
                               Margin="15,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               local:ThemeAsset.Path="Assets/search.png" />

                        <Button x:Name="ClearSearchButtonHorizontal"
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource NavbarFlatButtonStyle}"
                                Click="ClearSearchButtonHorizontal_Click"
                                Content="&#xE106;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{ThemeResource AppPrimaryTextBrush}"
                                Visibility="Collapsed" />

                        <Border Grid.Column="1"
                                Width="1"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AppMutedTextBrush}"
                                Opacity="0.45" />
                        <Button x:Name="SearchButtonHorizontal"
                                Grid.Column="1"
                                Width="64"
                                Height="40"
                                Style="{StaticResource NavbarFlatButtonStyle}"
                                Click="SearchButtonHorizontal_Click">
                            <Image local:ThemeAsset.Path="Assets/search.png" Width="21" Height="21" />
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="VoiceButtonHost"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AppDividerBrush}"
                        CornerRadius="20"
                        Opacity="0.45">
                    <Button x:Name="VoiceButtonHorizontal"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            IsHitTestVisible="False">
                        <Image local:ThemeAsset.Path="Assets/microphone.png" Width="22" Height="22" />
                    </Button>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Button x:Name="LegacySearchButtonHorizontal"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ShowSearchButton_Click"
                        Padding="8"
                        Visibility="Collapsed">
                    <Image local:ThemeAsset.Path="Assets/search.png" Width="24" Height="24" />
                </Button>
                <Button x:Name="SearchFiltersButtonHorizontal"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SearchFiltersButtonHorizontal_Click"
                        Padding="8"
                        Visibility="Collapsed">
                    <Image local:ThemeAsset.Path="Assets/more.png" Width="24" Height="24" />
                </Button>
                <Button x:Name="NotificationsButtonHorizontal"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NotificationsButton_Click"
                        Padding="8"
                        Visibility="Collapsed">
                    <Image local:ThemeAsset.Path="Assets/notifications.png" Width="24" Height="24" />
                </Button>
            </StackPanel>
        </Grid>

        <Popup x:Name="SearchSuggestionsPopup" IsLightDismissEnabled="False">
            <Border x:Name="SearchSuggestionsPopupBorder"
                    Width="644"
                    MaxHeight="560"
                    Background="{ThemeResource AppSurfaceAltBrush}"
                    BorderBrush="{ThemeResource AppDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <ListView x:Name="HistoryList"
                              IsItemClickEnabled="True"
                              ItemClick="HistoryList_ItemClick"
                              SelectionMode="None"
                              Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource NavbarSearchListItemStyle}" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="19" Height="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           local:ThemeAsset.Path="Assets/player/replay.png" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontFamily="Roboto"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                                               Text="{Binding SearchText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2"
                                            Width="40"
                                            Height="40"
                                            Style="{StaticResource NavbarFlatButtonStyle}"
                                            Click="RemoveHistoryItem_Click"
                                            Content="&#xE106;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView x:Name="SuggestionsList"
                              IsItemClickEnabled="True"
                              ItemClick="SuggestionsList_ItemClick"
                              SelectionMode="None"
                              Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource NavbarSearchListItemStyle}" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="19" Height="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           local:ThemeAsset.Path="Assets/search.png" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontFamily="Roboto"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                                               Text="{Binding}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Page>
