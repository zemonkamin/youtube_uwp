<Page
    x:Class="YouTube.Downloads"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="3"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,68,0,64">
                <TextBlock x:Name="PageTitleText"
                           Margin="16,0,16,16"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppPrimaryTextBrush}" />

                <Grid x:Name="EmptyState" Margin="12,42,12,0">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="390">
                        <TextBlock x:Name="EmptyTitleText"
                                   Margin="0,0,0,14"
                                   TextAlignment="Center"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryTextBrush}" />
                        <Image x:Name="EmptyIllustration"
                               local:ThemeAsset.Path="Assets/none_downloads.png"
                               Width="150" Height="100" Stretch="Uniform" />
                        <TextBlock x:Name="EmptyDescriptionText"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{ThemeResource AppSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="DownloadsList"
                              Visibility="Collapsed"
                              Background="{ThemeResource AppBackgroundBrush}"
                              HorizontalAlignment="Stretch"
                              Padding="8,8,8,16"
                              SizeChanged="DownloadsList_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="360"
                                           MaximumRowsOrColumns="3"
                                           HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButtonStyle}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Tag="ResponsiveCard"
                                    Loaded="ResponsiveCard_Loaded"
                                    SizeChanged="ResponsiveCard_SizeChanged"
                                    Margin="0,0,0,16"
                                    IsHoldingEnabled="True"
                                    IsRightTapEnabled="True"
                                    Holding="DownloadCard_Holding"
                                    RightTapped="DownloadCard_RightTapped"
                                    Click="DownloadCard_Click">
                                <StackPanel Orientation="Vertical"
                                            Background="{ThemeResource AppBackgroundBrush}"
                                            HorizontalAlignment="Stretch">
                                    <Grid SizeChanged="ThumbnailHost_SizeChanged"
                                          Tag="VideoCardThumbnailChrome">
                                        <Border Background="{ThemeResource VideoPlaceholderBrush}"
                                                Tag="VideoCardThumbnailChrome" />
                                        <Border Tag="VideoCardThumbnailChrome">
                                            <Image Stretch="UniformToFill"
                                                   DataContextChanged="Thumbnail_DataContextChanged" />
                                        </Border>
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,8,8"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="#CC000000">
                                            <TextBlock Text="{Binding QualityText}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="Medium" />
                                        </Border>
                                        <Border CornerRadius="8"
                                                Tag="DownloadProgressChrome">
                                            <Grid x:Name="DownloadProgressOverlay"
                                                  Visibility="{Binding DownloadingVisibility}"
                                                  Loaded="DownloadProgressOverlay_Loaded"
                                                  SizeChanged="DownloadProgressOverlay_SizeChanged"
                                                  DataContextChanged="DownloadProgressOverlay_DataContextChanged">
                                                <!-- The completed part remains slightly dimmed; the
                                                     stronger shade retreats from left to right. -->
                                                <Border Background="#38000000" />
                                                <Border x:Name="DownloadRemainingShade"
                                                        HorizontalAlignment="Right"
                                                        Background="#A8000000" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="DownloadProgressPercent"
                                                               VerticalAlignment="Center"
                                                               Foreground="White"
                                                               FontSize="20"
                                                               FontWeight="SemiBold" />
                                                    <Button Width="38" Height="38"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ShortsNoPressButtonStyle}"
                                                            Click="CancelDownload_Click">
                                                        <FontIcon Glyph="&#xE711;"
                                                                  FontFamily="Segoe MDL2 Assets"
                                                                  FontSize="17"
                                                                  Foreground="White" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,12,0,0"
                                          Tag="VideoCardMetadata">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36" VerticalAlignment="Top">
                                            <Border Background="{ThemeResource AvatarPlaceholderBrush}" />
                                            <Image Stretch="UniformToFill"
                                                   DataContextChanged="ChannelIcon_DataContextChanged"
                                                   Loaded="ChannelIcon_Loaded" />
                                            <Image Stretch="Fill"
                                                   IsHitTestVisible="False"
                                                   local:ThemeAsset.Path="Assets/rounding.png" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Roboto"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{ThemeResource AppPrimaryTextBrush}" />
                                            <TextBlock Text="{Binding Author}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Roboto"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppMutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <local:Navbar x:Name="navbar" Grid.Row="0" Canvas.ZIndex="20" />
        <local:Tabbar x:Name="tabbar" Grid.Row="2" Canvas.ZIndex="20" />

        <Grid x:Name="DownloadActionsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Canvas.ZIndex="100"
              Background="#80000000"
              Visibility="Collapsed"
              Tapped="DownloadActionsOverlay_Tapped" />

        <local:BottomSheet x:Name="DownloadActionsSheet"
                           Grid.Row="0"
                           Grid.RowSpan="3"
                           Canvas.ZIndex="101"
                           MaxHeight="126"
                           Margin="10,0,10,10"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Bottom"
                           HandleHeight="36"
                           HiddenOffset="146"
                           OverlayElementName="DownloadActionsOverlay">
            <Button x:Name="DeleteDownloadButton"
                    Height="64"
                    Margin="8,0,8,12"
                    Padding="16,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DeleteDownloadButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE74D;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="18"
                              Foreground="#FFFF3B30"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="DeleteDownloadText"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#FFFF3B30" />
                </Grid>
            </Button>
        </local:BottomSheet>
    </Grid>
</Page>
