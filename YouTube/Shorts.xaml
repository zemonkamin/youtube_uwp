<Page
    x:Class="YouTube.Shorts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F0F0F">

    <Page.Resources>
        <Style x:Key="ShortsIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <local:Navbar x:Name="navbar" Grid.Row="0" Visibility="Collapsed"/>

        <Grid x:Name="ShortsRoot"
              Grid.Row="1"
              Background="Black"
              SizeChanged="ShortsRoot_SizeChanged">
            <Grid x:Name="SwipeContent">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SwipeContentTransform"/>
                </Grid.RenderTransform>

                <local:CustomShortsPlayer x:Name="ShortsPlayer"/>

                <!-- Preview layers. The thumbnail of a short is derivable from its id, so the
                     neighbours can be shown instantly while their stream is still loading.
                     CurrentPreview covers the player until the new video actually starts;
                     Prev/Next sit one screen above and below and slide in with the drag. -->
                <Image x:Name="CurrentPreviewImage"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>

                <Image x:Name="PrevPreviewImage"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="PrevPreviewTransform"/>
                    </Image.RenderTransform>
                </Image>

                <Image x:Name="NextPreviewImage"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="NextPreviewTransform"/>
                    </Image.RenderTransform>
                </Image>

                <Grid x:Name="TopActionsPanel"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Margin="12,10,12,0"
                      IsHitTestVisible="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SearchTopButton"
                            Grid.Column="1"
                            Style="{StaticResource ShortsIconButtonStyle}"
                            Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            Click="SearchTopButton_Click">
                        <Image local:ThemeAsset.Path="Assets/Dark/search.png" Width="24" Height="24" Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="ShortsSettingsButton"
                            Grid.Column="2"
                            Style="{StaticResource ShortsIconButtonStyle}"
                            Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            Click="ShortsSettingsButton_Click">
                        <Image local:ThemeAsset.Path="Assets/Dark/player/settings.png" Width="22" Height="22" Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="MoreTopButton"
                            Grid.Column="3"
                            Style="{StaticResource ShortsIconButtonStyle}"
                            Width="34"
                            Height="34"
                            Click="MoreTopButton_Click">
                        <Image local:ThemeAsset.Path="Assets/Dark/more.png" Width="24" Height="24" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Grid x:Name="GestureLayer"
                      Background="Transparent"
                      Margin="0,52,76,20"
                      PointerPressed="GestureLayer_PointerPressed"
                      PointerMoved="GestureLayer_PointerMoved"
                      PointerReleased="GestureLayer_PointerReleased"
                      PointerCanceled="GestureLayer_PointerCanceled"/>

                <Grid x:Name="MetadataOverlay"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Stretch"
                      Margin="14,0,82,16"
                      IsHitTestVisible="True">
                    <StackPanel>
                        <Grid x:Name="ChannelHeaderPanel"
                              Height="34"
                              Margin="0,0,0,6"
                              Background="Transparent"
                              Tapped="ChannelHeaderPanel_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="30" Height="30" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource AvatarPlaceholderBrush}"/>
                                <Ellipse x:Name="ChannelAvatarEllipse">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ChannelAvatarBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <TextBlock x:Name="ChannelNameText"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="ShortTitleText"
                                   Text=""
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"
                                   MaxLines="2"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="RightButtonsPanel"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,18">
                    <StackPanel HorizontalAlignment="Center">
                        <Button x:Name="LikeButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="42"
                                Height="42"
                                Click="LikeButton_Click">
                            <Image x:Name="LikeIconImage" local:ThemeAsset.Path="Assets/Dark/player/like.png" Width="28" Height="28"/>
                        </Button>
                        <TextBlock x:Name="LikeCountText"
                                   Text="Like"
                                   Margin="0,2,0,0"
                                   Foreground="White"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="DislikeButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="42"
                                Height="42"
                                Click="DislikeButton_Click">
                            <Image x:Name="DislikeIconImage" local:ThemeAsset.Path="Assets/Dark/player/dislike.png" Width="28" Height="28"/>
                        </Button>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="CommentsButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="42"
                                Height="42"
                                Click="CommentsButton_Click">
                            <Image local:ThemeAsset.Path="Assets/Dark/player/comments.png" Width="28" Height="28"/>
                        </Button>
                        <TextBlock x:Name="CommentCountText"
                                   Text="Comments"
                                   Margin="0,2,0,0"
                                   Foreground="White"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="SendButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="42"
                                Height="42"
                                Click="SendButton_Click">
                            <Image local:ThemeAsset.Path="Assets/Dark/player/send.png" Width="28" Height="28"/>
                        </Button>
                        <TextBlock Text="Share"
                                   Margin="0,2,0,0"
                                   Foreground="White"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="LoadingOverlay"
                  Background="#99000000"
                  Visibility="Collapsed">
                <local:AndroidLoadingRing x:Name="LoadingRing"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          Width="36"
                                          Height="36"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="EmptyMessageText"
                       Text=""
                       Foreground="White"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="32"
                       Visibility="Collapsed"/>

            <Grid x:Name="ShortsOverlayGrid"
                  Background="#99000000"
                  Visibility="Collapsed"
                  Tapped="ShortsOverlayGrid_Tapped"/>

            <!-- Bottom Sheet Panel for Comments -->
            <Border x:Name="CommentsBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppSurfaceBrush}"
                    CornerRadius="15"
                    Height="390"
                    Margin="10,0,10,8"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CommentsBottomSheetTransform" Y="400"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="Transparent"
                          Height="40"
                          Tapped="CommentsDragArea_Tapped"
                          PointerPressed="CommentsDragArea_PointerPressed"
                          PointerMoved="CommentsDragArea_PointerMoved"
                          PointerReleased="CommentsDragArea_PointerReleased"
                          PointerCaptureLost="CommentsDragArea_PointerReleased">
                        <Rectangle Width="40"
                                   Height="4"
                                   Fill="{ThemeResource AppMutedTextBrush}"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CommentsSheetTitle"
                                   Text="Comments"
                                   Grid.Row="0"
                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="CommentsScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CommentsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <Ellipse Fill="{ThemeResource AvatarPlaceholderBrush}"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AuthorThumbnail}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Author}" Foreground="{ThemeResource AppSecondaryTextBrush}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PublishedAt}" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12" Margin="8,0,0,0"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" Foreground="{ThemeResource AppPrimaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid x:Name="CommentsLoadingPanel" Background="{ThemeResource AppSurfaceBrush}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <local:AndroidLoadingRing x:Name="CommentsLoadingRing"
                                                              IsActive="False"
                                                              Visibility="Collapsed"
                                                              Width="36"
                                                              Height="36"
                                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Loading comments..."
                                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                                               FontSize="14"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="CommentsEmptyText"
                                       Text="No comments found."
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom Sheet Panel for Share -->
            <Border x:Name="ShareBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="#222222"
                    CornerRadius="15"
                    Height="356"
                    Margin="10,0,10,8"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ShareBottomSheetTransform" Y="366"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="Transparent"
                          Height="32"
                          Tapped="ShareDragArea_Tapped"
                          PointerPressed="ShareDragArea_PointerPressed"
                          PointerMoved="ShareDragArea_PointerMoved"
                          PointerReleased="ShareDragArea_PointerReleased"
                          PointerCaptureLost="ShareDragArea_PointerReleased">
                        <Rectangle Width="36"
                                   Height="4"
                                   Fill="#787878"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ShareVideoTitleText"
                                               Grid.Column="0"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               MaxLines="2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <Button x:Name="ShareTimeToggleButton"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortsIconButtonStyle}"
                                            Width="42"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            Click="ShareTimeToggleButton_Click">
                                        <Grid Width="42" Height="24">
                                            <Border x:Name="ShareTimeToggleTrack"
                                                    Width="42"
                                                    Height="24"
                                                    Background="#9B9B9B"
                                                    CornerRadius="12"/>
                                            <Ellipse x:Name="ShareTimeToggleThumb"
                                                     Width="18"
                                                     Height="18"
                                                     Fill="#222222"
                                                     HorizontalAlignment="Left"
                                                     Margin="3,3,0,3">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="ShareTimeToggleThumbTransform" X="0"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="ShareChannelText"
                                           Foreground="#9F9F9F"
                                           FontSize="13"
                                           Margin="0,0,0,10"/>

                                <Border Background="#323232"
                                        CornerRadius="12"
                                        Padding="12,10,12,10"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image local:ThemeAsset.Path="Assets/link.png"
                                               Width="20"
                                               Height="20"
                                               VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ShareUrlTextBlock"
                                                   Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="WrapWholeWords"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ShareButtonsPanel">
                                    <Button x:Name="CopyLinkButton"
                                            Style="{StaticResource FlatActionButtonStyle}"
                                            Height="54"
                                            Margin="0,0,0,4"
                                            Click="CopyLinkButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" Background="#373737" CornerRadius="21" VerticalAlignment="Center">
                                                <Image local:ThemeAsset.Path="Assets/copy.png" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Copy link" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShowQrButton"
                                            Style="{StaticResource FlatActionButtonStyle}"
                                            Height="54"
                                            Margin="0,0,0,4"
                                            Click="ShowQrButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" Background="#373737" CornerRadius="21" VerticalAlignment="Center">
                                                <Image local:ThemeAsset.Path="Assets/qr.png" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Show QR code" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShareViaSystemButton"
                                            Style="{StaticResource FlatActionButtonStyle}"
                                            Height="54"
                                            Margin="0,0,0,2"
                                            Click="ShareViaSystemButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" Background="#373737" CornerRadius="21" VerticalAlignment="Center">
                                                <Image local:ThemeAsset.Path="Assets/share.png" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Share via..." Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="DescriptionBottomSheetPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="#222222"
                    CornerRadius="15"
                    Height="320"
                    Margin="10,0,10,8"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DescriptionBottomSheetTransform" Y="330"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="Transparent"
                          Height="32"
                          Tapped="DescriptionDragArea_Tapped"
                          PointerPressed="DescriptionDragArea_PointerPressed"
                          PointerMoved="DescriptionDragArea_PointerMoved"
                          PointerReleased="DescriptionDragArea_PointerReleased"
                          PointerCaptureLost="DescriptionDragArea_PointerReleased">
                        <Rectangle Width="36"
                                   Height="4"
                                   Fill="#787878"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Description"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="DescriptionTitleText"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="DescriptionChannelText"
                                           Foreground="#A0A0A0"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="DescriptionBodyText"
                                           Foreground="#CFCFCF"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="CopiedPopupPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#222222"
                    CornerRadius="18"
                    Width="280"
                    Padding="18"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Link copied"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Shorts link has been copied to clipboard"
                               Foreground="#CFCFCF"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Button x:Name="CopiedPopupOkButton"
                            Content="OK"
                            HorizontalAlignment="Stretch"
                            Click="CopiedPopupOkButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="QrPopupPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#222222"
                    CornerRadius="18"
                    Width="300"
                    Padding="18"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="QR code"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>
                    <Border Width="220"
                            Height="220"
                            Background="#4C4C4C"
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Border Background="White" CornerRadius="12" Padding="8">
                            <Image x:Name="QrCodeImage" Stretch="Uniform"/>
                        </Border>
                    </Border>
                    <Button x:Name="QrPopupCloseButton"
                            Content="Close"
                            HorizontalAlignment="Stretch"
                            Click="QrPopupCloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <local:Tabbar x:Name="tabbar" Grid.Row="2"/>

        <!-- Compact Shorts settings bottom sheet (quality / speed / optional audio). -->
        <Grid x:Name="ShortsSettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="Collapsed"
              Tapped="ShortsSettingsOverlay_Tapped"/>

        <!-- Settings sheet. Same shape as the one on the video page: floating rounded card,
             drag handle, one full-width row per section. -->
        <Grid x:Name="ShortsSettingsSheet"
              Grid.Row="0"
              Grid.RowSpan="3"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="#222222"
              CornerRadius="15"
              MaxHeight="240"
              Margin="10,0,10,10"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShortsSettingsSheetTransform" Y="270"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Full-width drag area -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  Height="40"
                  Tapped="ShortsSettingsDragArea_Tapped"
                  PointerPressed="ShortsSettingsDragArea_PointerPressed"
                  PointerMoved="ShortsSettingsDragArea_PointerMoved"
                  PointerReleased="ShortsSettingsDragArea_PointerReleased"
                  PointerCaptureLost="ShortsSettingsDragArea_PointerReleased">
                <Rectangle Width="40"
                           Height="4"
                           Fill="Gray"
                           RadiusX="2"
                           RadiusY="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,20">
                <!-- Main list -->
                <StackPanel x:Name="ShortsMainSettingsPanel">
                    <Button x:Name="ShortsQualityButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="ShortsQualityButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/quality.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Quality" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="ShortsQualityValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/Dark/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ShortsSpeedButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="ShortsSpeedButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Playback speed" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="ShortsSpeedValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/Dark/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ShortsAudioTrackButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Visibility="Collapsed"
                            Click="ShortsAudioTrackButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Audio track" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="ShortsAudioValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/Dark/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>


                </StackPanel>

                <!-- Options list for whichever section was opened -->
                <ScrollViewer x:Name="ShortsSubSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="ShortsSubSettingsHeader"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"
                                   FontSize="16"/>
                        <StackPanel x:Name="ShortsSubOptionsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

    </Grid>
</Page>
