<Page
    x:Class="YouTube.Shorts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F0F0F">

    <Page.Resources>
        <Style x:Key="ShortsIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ShortCommentThreadTemplate">
            <StackPanel Margin="0,10,0,10" HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Ellipse Fill="{ThemeResource AvatarPlaceholderBrush}"/>
                        <Ellipse DataContextChanged="CommentAuthorImage_DataContextChanged"
                                 Loaded="CommentAuthorImage_Loaded">
                            <Ellipse.Fill>
                                <ImageBrush Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Author}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PublishedAt}"
                                       Margin="8,0,0,0" FontSize="12"
                                       Foreground="{ThemeResource AppMutedTextBrush}"/>
                        </StackPanel>
                        <RichTextBlock Margin="0,4,0,0" FontSize="14"
                                       Foreground="{ThemeResource AppPrimaryTextBrush}"
                                       IsTextSelectionEnabled="False"
                                       Loaded="CommentTextRichTextBlock_Loaded"
                                       Tag="{Binding Text}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Image Width="17" Height="17"
                                   local:ThemeAsset.Path="Assets/player/like.png"/>
                            <TextBlock Text="{Binding LikeCount}"
                                       Margin="6,0,0,0"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"/>
                            <Image Width="17" Height="17" Margin="14,0,0,0"
                                   local:ThemeAsset.Path="Assets/player/dislike.png"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Button Style="{StaticResource CardButtonStyle}"
                        Visibility="{Binding RepliesButtonVisibility}"
                        Margin="46,8,0,0" Padding="0"
                        HorizontalAlignment="Left"
                        Click="CommentRepliesButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RepliesText}" Foreground="{ThemeResource AppPrimaryTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Image Width="16" Height="16" Margin="8,0,0,0"
                               Stretch="Uniform" VerticalAlignment="Center"
                               local:ThemeAsset.Path="Assets/down_arrow.png"/>
                    </StackPanel>
                </Button>
                <local:AndroidLoadingRing Width="20" Height="20"
                                          Margin="46,8,0,0"
                                          HorizontalAlignment="Left"
                                          IsActive="{Binding RepliesLoadingActive}"
                                          Visibility="{Binding RepliesLoadingVisibility}"/>

                <ItemsControl ItemsSource="{Binding Replies}" Margin="30,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8,0,8" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Ellipse Fill="{ThemeResource AvatarPlaceholderBrush}"/>
                                    <Ellipse DataContextChanged="CommentAuthorImage_DataContextChanged"
                                             Loaded="CommentAuthorImage_Loaded">
                                        <Ellipse.Fill>
                                            <ImageBrush Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Author}"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PublishedAt}"
                                                   Margin="8,0,0,0" FontSize="12"
                                                   Foreground="{ThemeResource AppMutedTextBrush}"/>
                                    </StackPanel>
                                    <RichTextBlock Margin="0,4,0,0" FontSize="14"
                                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                   IsTextSelectionEnabled="False"
                                                   Loaded="CommentTextRichTextBlock_Loaded"
                                                   Tag="{Binding Text}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Image Width="17" Height="17"
                                               local:ThemeAsset.Path="Assets/player/like.png"/>
                                        <TextBlock Text="{Binding LikeCount}"
                                                   Margin="6,0,0,0"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppSecondaryTextBrush}"/>
                                        <Image Width="17" Height="17" Margin="14,0,0,0"
                                               local:ThemeAsset.Path="Assets/player/dislike.png"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <local:Navbar x:Name="navbar" Grid.Row="0" Visibility="Collapsed"/>

        <Grid x:Name="ShortsRoot"
              Grid.Row="1"
              Background="Black"
              SizeChanged="ShortsRoot_SizeChanged">
            <Grid x:Name="SwipeContent">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SwipeContentTransform"/>
                </Grid.RenderTransform>

                <local:CustomShortsPlayer x:Name="ShortsPlayer"/>

                <!-- Preview layers. The thumbnail of a short is derivable from its id, so the
                     neighbours can be shown instantly while their stream is still loading.
                     CurrentPreview covers the player until the new video actually starts;
                     Prev/Next sit one screen above and below and slide in with the drag. -->
                <Image x:Name="CurrentPreviewImage"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>

                <Image x:Name="PrevPreviewImage"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="PrevPreviewTransform"/>
                    </Image.RenderTransform>
                </Image>

                <Image x:Name="NextPreviewImage"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="NextPreviewTransform"/>
                    </Image.RenderTransform>
                </Image>

                <Grid x:Name="TopActionsPanel"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Margin="12,10,12,0"
                      IsHitTestVisible="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SearchTopButton"
                            Grid.Column="1"
                            Style="{StaticResource ShortsIconButtonStyle}"
                            Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            Click="SearchTopButton_Click">
                        <Image local:ThemeAsset.Path="Assets/Dark/search.png" Width="24" Height="24" Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="ShortsSettingsButton"
                            Grid.Column="2"
                            Style="{StaticResource ShortsIconButtonStyle}"
                            Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            Click="ShortsSettingsButton_Click">
                        <Image local:ThemeAsset.Path="Assets/Dark/player/settings.png" Width="22" Height="22" Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="MoreTopButton"
                            Grid.Column="3"
                            Style="{StaticResource ShortsIconButtonStyle}"
                            Width="34"
                            Height="34"
                            Click="MoreTopButton_Click">
                        <Image local:ThemeAsset.Path="Assets/Dark/more.png" Width="24" Height="24" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Grid x:Name="GestureLayer"
                      Background="Transparent"
                      Margin="0,52,76,20"
                      PointerPressed="GestureLayer_PointerPressed"
                      PointerMoved="GestureLayer_PointerMoved"
                      PointerReleased="GestureLayer_PointerReleased"
                      PointerCanceled="GestureLayer_PointerCanceled"/>

                <Grid x:Name="MetadataOverlay"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Stretch"
                      Margin="14,0,82,16"
                      IsHitTestVisible="True">
                    <StackPanel>
                        <Grid x:Name="ChannelHeaderPanel"
                              Height="34"
                              Margin="0,0,0,6"
                              Background="Transparent"
                              Tapped="ChannelHeaderPanel_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="30" Height="30" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource AvatarPlaceholderBrush}"/>
                                <Ellipse x:Name="ChannelAvatarEllipse">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ChannelAvatarBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <TextBlock x:Name="ChannelNameText"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="ShortTitleText"
                                   Text=""
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"
                                   MaxLines="2"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="RightButtonsPanel"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,18">
                    <StackPanel HorizontalAlignment="Center">
                        <Button x:Name="LikeButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="34"
                                Height="34"
                                Click="LikeButton_Click">
                            <Image x:Name="LikeIconImage" local:ThemeAsset.Path="Assets/Dark/player/like.png" Width="24" Height="24"/>
                        </Button>
                        <TextBlock x:Uid="Loc_Like_Text" x:Name="LikeCountText"
                                   Margin="0,2,0,0"
                                   Foreground="White"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="DislikeButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="34"
                                Height="34"
                                Click="DislikeButton_Click">
                            <Image x:Name="DislikeIconImage" local:ThemeAsset.Path="Assets/Dark/player/dislike.png" Width="24" Height="24"/>
                        </Button>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="CommentsButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="34"
                                Height="34"
                                Click="CommentsButton_Click">
                            <Image local:ThemeAsset.Path="Assets/Dark/player/comments.png" Width="24" Height="24"/>
                        </Button>
                        <TextBlock x:Uid="Loc_Comments_Text" x:Name="CommentCountText"
                                   Visibility="Collapsed"
                                   Margin="0,2,0,0"
                                   Foreground="White"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="SendButton"
                                Style="{StaticResource ShortsIconButtonStyle}"
                                Width="34"
                                Height="34"
                                Click="SendButton_Click">
                            <Image local:ThemeAsset.Path="Assets/Dark/player/send.png" Width="24" Height="24"/>
                        </Button>
                        <TextBlock x:Uid="Loc_Share_Text"
                                   Visibility="Collapsed"
                                   Margin="0,2,0,0"
                                   Foreground="White"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="LoadingOverlay"
                  Background="#99000000"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
                <local:AndroidLoadingRing x:Name="LoadingRing"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          Width="36"
                                          Height="36"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="EmptyMessageText"
                       Text=""
                       Foreground="White"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="32"
                       Visibility="Collapsed"/>

        </Grid>

            <Grid x:Name="ShortsOverlayGrid"
                  Grid.Row="0"
                  Grid.RowSpan="3"
                  Canvas.ZIndex="100"
                  Background="#99000000"
                  Visibility="Collapsed"
                  Tapped="ShortsOverlayGrid_Tapped"/>

            <!-- Bottom Sheet Panel for Comments -->
            <local:BottomSheet x:Name="CommentsBottomSheetPanel"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Canvas.ZIndex="101"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    MaxHeight="390"
                    Margin="10,0,10,8"
                    Visibility="Collapsed" OverlayElementName="ShortsOverlayGrid" HandleHeight="36" HandleTapped="CommentsDragArea_Tapped" HandlePointerPressed="CommentsDragArea_PointerPressed" HandlePointerMoved="CommentsDragArea_PointerMoved" HandlePointerReleased="CommentsDragArea_PointerReleased">
                <local:BottomSheet.RenderTransform>
                    <TranslateTransform x:Name="CommentsBottomSheetTransform" Y="400"/>
                </local:BottomSheet.RenderTransform>

                <Grid>
                    <Grid Margin="16,0,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Uid="Loc_Comments_Text" x:Name="CommentsSheetTitle"
                                   Grid.Row="0"
                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="CommentsScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CommentsItemsControl"
                                              ItemTemplate="{StaticResource ShortCommentThreadTemplate}"/>
                            </ScrollViewer>

                            <Grid x:Name="CommentsLoadingPanel" Background="{ThemeResource AppSurfaceAltBrush}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <local:AndroidLoadingRing x:Name="CommentsLoadingRing"
                                                              IsActive="False"
                                                              Visibility="Collapsed"
                                                              Width="36"
                                                              Height="36"
                                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Uid="Loc_LoadingComments_Text"
                                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                                               FontSize="14"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Uid="Loc_NoCommentsFound_Text" x:Name="CommentsEmptyText"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>
            </local:BottomSheet>

            <!-- Bottom Sheet Panel for Share -->
            <local:BottomSheet x:Name="ShareBottomSheetPanel"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Canvas.ZIndex="101"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    MaxHeight="330"
                    Margin="10,0,10,10"
                    Visibility="Collapsed" OverlayElementName="ShortsOverlayGrid" HandleHeight="36" HandleTapped="ShareDragArea_Tapped" HandlePointerPressed="ShareDragArea_PointerPressed" HandlePointerMoved="ShareDragArea_PointerMoved" HandlePointerReleased="ShareDragArea_PointerReleased">
                <local:BottomSheet.RenderTransform>
                    <TranslateTransform x:Name="ShareBottomSheetTransform" Y="340"/>
                </local:BottomSheet.RenderTransform>

                <Grid>
                    <Grid Margin="20,0,20,10">
                        <ScrollViewer MaxHeight="286"
                                      VerticalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ShareVideoTitleText"
                                               Grid.Column="0"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               MaxLines="2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <Button x:Name="ShareTimeToggleButton"
                                            Grid.Column="1"
                                            Style="{StaticResource ShortsIconButtonStyle}"
                                            Width="50"
                                            Height="28"
                                            VerticalAlignment="Center"
                                            Click="ShareTimeToggleButton_Click">
                                        <Grid Width="50" Height="28">
                                            <Border x:Name="ShareTimeToggleTrack"
                                                    Width="50"
                                                    Height="28"
                                                    Background="#9B9B9B"
                                                    CornerRadius="14"/>
                                            <Ellipse x:Name="ShareTimeToggleThumb"
                                                     Width="20"
                                                     Height="20"
                                                     Fill="#222222"
                                                     HorizontalAlignment="Left"
                                                     Margin="4,4,0,4">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="ShareTimeToggleThumbTransform" X="0"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="ShareChannelText"
                                           Foreground="#9F9F9F"
                                           FontSize="14"
                                           Margin="0,0,0,12"/>

                                <Border Background="#323232"
                                        CornerRadius="12"
                                        Padding="12,10,12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image local:ThemeAsset.Path="Assets/link.png"
                                               Width="24"
                                               Height="24"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ShareUrlTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ShareButtonsPanel">
                                    <Button x:Name="CopyLinkButton"
                                            Style="{StaticResource FlatActionButtonStyle}"
                                            Height="44"
                                            Margin="0,0,0,4"
                                            Click="CopyLinkButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#373737" CornerRadius="18" VerticalAlignment="Center">
                                                <Image local:ThemeAsset.Path="Assets/copy.png" Width="24" Height="24" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Uid="Loc_CopyLink_Text" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShowQrButton"
                                            Style="{StaticResource FlatActionButtonStyle}"
                                            Height="44"
                                            Margin="0,0,0,4"
                                            Click="ShowQrButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#373737" CornerRadius="18" VerticalAlignment="Center">
                                                <Image local:ThemeAsset.Path="Assets/qr.png" Width="24" Height="24" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Uid="Loc_ShowQRCode_Text" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShareViaSystemButton"
                                            Style="{StaticResource FlatActionButtonStyle}"
                                            Height="44"
                                            Click="ShareViaSystemButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#373737" CornerRadius="18" VerticalAlignment="Center">
                                                <Image local:ThemeAsset.Path="Assets/share.png" Width="24" Height="24" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Uid="Loc_ShareVia_Text" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </local:BottomSheet>

            <local:BottomSheet x:Name="DescriptionBottomSheetPanel"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Canvas.ZIndex="101"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    MaxHeight="320"
                    Margin="10,0,10,8"
                    Visibility="Collapsed" OverlayElementName="ShortsOverlayGrid" HandleHeight="36" HandleTapped="DescriptionDragArea_Tapped" HandlePointerPressed="DescriptionDragArea_PointerPressed" HandlePointerMoved="DescriptionDragArea_PointerMoved" HandlePointerReleased="DescriptionDragArea_PointerReleased">
                <local:BottomSheet.RenderTransform>
                    <TranslateTransform x:Name="DescriptionBottomSheetTransform" Y="330"/>
                </local:BottomSheet.RenderTransform>

                <Grid>
                    <Grid Margin="16,0,16,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Uid="Loc_Description_Text"
                                           Foreground="{ThemeResource AppPrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="DescriptionTitleText"
                                           Foreground="{ThemeResource AppPrimaryTextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="DescriptionChannelText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="DescriptionBodyText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </local:BottomSheet>

            <!-- Copy-link / QR result sheet. Same bottom-sheet shape and gesture as Share. -->
            <local:BottomSheet x:Name="ShareResultPopupPanel"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Canvas.ZIndex="102"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Margin="10,0,10,10"
                    MaxHeight="390"
                    Visibility="Collapsed" OverlayElementName="" HandleHeight="36" HandleTapped="ShareResultDragArea_Tapped" HandlePointerPressed="ShareResultDragArea_PointerPressed" HandlePointerMoved="ShareResultDragArea_PointerMoved" HandlePointerReleased="ShareResultDragArea_PointerReleased">
                <local:BottomSheet.RenderTransform>
                    <TranslateTransform x:Name="ShareResultPopupTransform" Y="400"/>
                </local:BottomSheet.RenderTransform>
                <Grid>
                    <ScrollViewer
                                  MaxHeight="350"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,0,20,12">
                        <TextBlock x:Uid="Loc_ShortsLinkHasBeenCopiedToClipboard_Text"
                                   x:Name="ShareResultLocalizedCopiedText"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="ShareResultTitleText"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords"
                                   Margin="0,0,0,10"/>

                        <Border x:Name="ShareResultImageHolder"
                                Width="224"
                                Height="224"
                                HorizontalAlignment="Center"
                                Background="#4C4C4C"
                                CornerRadius="15"
                                Padding="10"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <Border Background="White" CornerRadius="12" Padding="8">
                                <Image x:Name="QrCodeImage" Stretch="Uniform"/>
                            </Border>
                        </Border>

                        <TextBlock x:Name="ShareResultMessageText"
                                   Foreground="#CFCFCF"
                                   FontSize="13"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </local:BottomSheet>

        <local:Tabbar x:Name="tabbar" Grid.Row="2" Canvas.ZIndex="20"/>

        <!-- Compact Shorts settings bottom sheet (quality / speed / optional audio). -->
        <Grid x:Name="ShortsSettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Canvas.ZIndex="100"
              Background="#80000000"
              Visibility="Collapsed"
              Tapped="ShortsSettingsOverlay_Tapped"/>

        <!-- Settings sheet. Same shape as the one on the video page: floating rounded card,
             drag handle, one full-width row per section. -->
        <local:BottomSheet x:Name="ShortsSettingsSheet"
              Grid.Row="0"
              Grid.RowSpan="3"
              Canvas.ZIndex="101"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              MaxHeight="240"
              Margin="10,0,10,10"
              Visibility="Collapsed" OverlayElementName="ShortsOverlayGrid" HandleHeight="36" HandleTapped="ShortsSettingsDragArea_Tapped" HandlePointerPressed="ShortsSettingsDragArea_PointerPressed" HandlePointerMoved="ShortsSettingsDragArea_PointerMoved" HandlePointerReleased="ShortsSettingsDragArea_PointerReleased">
            <local:BottomSheet.RenderTransform>
                <TranslateTransform x:Name="ShortsSettingsSheetTransform" Y="270"/>
            </local:BottomSheet.RenderTransform>
            <Grid>
            <Grid Margin="20,0,20,20">
                <!-- Main list -->
                <StackPanel x:Name="ShortsMainSettingsPanel">
                    <Button x:Name="ShortsQualityButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="ShortsQualityButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/quality.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_Quality_Text" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="ShortsQualityValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/Dark/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ShortsSpeedButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="ShortsSpeedButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_PlaybackSpeed_Text" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="ShortsSpeedValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/Dark/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ShortsAudioTrackButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Visibility="Collapsed"
                            Click="ShortsAudioTrackButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_AudioTrack_Text" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="ShortsAudioValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/Dark/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>


                </StackPanel>

                <!-- Options list for whichever section was opened -->
                <ScrollViewer x:Name="ShortsSubSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="ShortsSubSettingsHeader"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"
                                   FontSize="16"/>
                        <StackPanel x:Name="ShortsSubOptionsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        
            </Grid></local:BottomSheet>

    </Grid>
</Page>
