                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SkeletonRelatedColumn" Width="400" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <Border Height="211" Background="{ThemeResource AppSurfaceAltBrush}" />
                    <Grid
                        x:Name="TitleDescriptionSkeletonImagePart"
                        Margin="16,16,16,0"
                        HorizontalAlignment="Stretch"
                        Visibility="Visible">
                        <Grid
                            x:Name="TitleDescriptionSkeletonHost"
                            HorizontalAlignment="Stretch"
                            SizeChanged="TitleDescriptionSkeletonHost_SizeChanged">
                            <Image
                                x:Name="TitleDescriptionSkeletonImage"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ImageOpened="TitleDescriptionSkeletonImage_ImageOpened"
                                local:ThemeAsset.Path="Assets/yt_skeleton/title_description.png"
                                Stretch="Uniform" />
                        </Grid>
                    </Grid>

                    <!-- Landscape-only metadata skeleton.  Keep every rounded shape as a
                         Border.CornerRadius: this is supported by the original Windows 10 UWP
                         XAML stack used by Windows 10 Mobile, unlike newer control corner APIs. -->
                    <StackPanel
                        x:Name="TitleDescriptionSkeletonClassicPart"
                        Margin="16,16,16,0"
                        Visibility="Collapsed">

                        <!-- Video title -->
                        <Border
                            Height="20"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AppSurfaceAltBrush}"
                            CornerRadius="10" />

                        <!-- Channel avatar/name + Subscribe pill -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="48"
                                Height="48"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AppSurfaceAltBrush}"
                                CornerRadius="24" />

                            <Border
                                Grid.Column="1"
                                Height="16"
                                Margin="12,0,16,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AppSurfaceAltBrush}"
                                CornerRadius="8" />

                            <Border
                                Grid.Column="2"
                                Width="112"
                                Height="40"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AppSurfaceAltBrush}"
                                CornerRadius="20" />
                        </Grid>

                        <!-- Like/comment/share action placeholders -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Height="42"
                                Background="{ThemeResource AppSurfaceAltBrush}"
                                CornerRadius="21" />
                            <Border
                                Grid.Column="2"
                                Height="42"
                                Background="{ThemeResource AppSurfaceAltBrush}"
                                CornerRadius="21" />
                        </Grid>

                        <!-- Description block -->
                        <Border
                            Height="120"
                            Margin="0,20,0,16"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AppSurfaceAltBrush}"
                            CornerRadius="12" />
