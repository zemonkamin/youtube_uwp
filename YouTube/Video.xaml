<Page
    x:Class="YouTube.Video"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:YouTube.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:YouTube"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#0F0F0F"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ViewsCountConverter x:Key="ViewsCountConverter" />
        <converters:RelativeDateConverter x:Key="RelativeDateConverter" />

        <Style x:Key="RatingIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RelatedVideoCardStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Background="Transparent"
                                Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1A1A1A" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#222222" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ShareActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareTimeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="68" Height="34" Background="Transparent">
                            <Border x:Name="SwitchBackground"
                                    Background="#A8A8A8"
                                    CornerRadius="17"
                                    BorderBrush="#A8A8A8"
                                    BorderThickness="2"/>
                            <Ellipse x:Name="SwitchKnob"
                                     Width="24"
                                     Height="24"
                                     Fill="#202124"
                                     HorizontalAlignment="Left"
                                     Margin="5,0,0,0"
                                     VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#A8A8A8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchBackground" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#A8A8A8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnob" Storyboard.TargetProperty="HorizontalAlignment">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Left"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnob" Storyboard.TargetProperty="Margin">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="5,0,0,0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchBackground" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnob" Storyboard.TargetProperty="HorizontalAlignment">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Right"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SwitchKnob" Storyboard.TargetProperty="Margin">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0,0,5,0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ShareTimeToggleButtonNoHoverStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PlayerColumn" Width="*" />
                <ColumnDefinition x:Name="RelatedColumn" Width="400" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                x:Name="MainScrollViewer"
                Grid.Column="0"
                VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="PlayerInfoPanel">
                    <Grid.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="30" />
                        </TransitionCollection>
                    </Grid.ChildrenTransitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- Playlist / mix queue -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="VideoPlayerContainer"
                        Grid.Row="0"
                        Background="Black"
                        SizeChanged="VideoPlayerContainer_SizeChanged">
                        <local:CustomVideoPlayer
                            x:Name="CustomVideoPlayer"
                            Height="Auto"
                            MinHeight="211"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            FullscreenRequested="CustomVideoPlayer_FullscreenRequested" />
                        <Grid
                            x:Name="SkipOverlay"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <Border
                                x:Name="SkipOverlayBorder"
                                Margin="20,0,0,0"
                                Padding="20"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <StackPanel x:Name="SkipOverlayPanel" Orientation="Horizontal">
                                    <Image
                                        x:Name="SkipIcon"
                                        Width="48"
                                        Height="48"
                                        Margin="0,0,10,0" />
                                    <TextBlock
                                        x:Name="SkipText"
                                        FontSize="32"
                                        FontWeight="Bold"
                                        Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Button
                        x:Name="VideoInfoButton"
                        Grid.Row="1"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="VideoInfoButton_Click">
                        <StackPanel Margin="16,12">
                            <TextBlock
                                x:Name="VideoTitleText"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="White"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="VideoViewsText" Visibility="Collapsed" />
                            <TextBlock x:Name="VideoUploadDateText" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="2" Margin="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Channel info: a fixed avatar plus a flexible text column so a long
                             channel name ellipsizes inside the available width instead of pushing
                             the Subscribe button off the right edge. -->
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                x:Name="ChannelPicture"
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                Tapped="ChannelPicture_Tapped">
                                <Ellipse Fill="#333333" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ChannelImage" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Tapped="ChannelPicture_Tapped">
                                <TextBlock
                                    x:Name="VideoAuthorText"
                                    FontSize="15"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="SubscriberCountText"
                                    FontSize="12"
                                    Foreground="#AAAAAA"
                                    Margin="0,2,0,0"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Border
                            x:Name="SubscribeButtonContainer"
                            Grid.Column="1"
                            Background="#f1f1f1"
                            BorderBrush="#f1f1f1"
                            BorderThickness="1"
                            CornerRadius="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="SubscribeButton"
                                Style="{StaticResource RatingIconButtonStyle}"
                                Padding="14,7"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SubscribeButton_Click"
                                FontSize="13"
                                Foreground="#FF0F0F0F">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="SubscribeButtonText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FF0F0F0F"
                                        Text="Subscribe" />
                                    <StackPanel
                                        x:Name="SubscribeSubscribedIconsPanel"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                        <Image
                                            x:Name="SubscribeNotificationIcon"
                                            Width="22"
                                            MinWidth="22"
                                            Height="22"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            Source="Assets/notifications.png"
                                            Visibility="Visible" />
                                        <Image
                                            x:Name="SubscribeDownArrowIcon"
                                            Width="16"
                                            MinWidth="16"
                                            Height="16"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            Source="Assets/down_arrow.png"
                                            Visibility="Visible" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="3"
                        Margin="16,2,16,16"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                x:Name="LikeDislikeContainer"
                                Margin="0,0,8,0"
                                Background="#272727"
                                CornerRadius="18">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Name="LikeButton"
                                        Style="{StaticResource RatingIconButtonStyle}"
                                        Padding="16,8,8,8"
                                        Background="Transparent"
                                        Click="LikeButton_Click"
                                        BorderThickness="0"
                                        Foreground="White">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                x:Name="LikeIcon"
                                                Width="20"
                                                Height="20"
                                                Source="Assets/player/like.png" />
                                            <TextBlock
                                                x:Name="LikeCountText"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                    <Rectangle
                                        Width="0.75"
                                        Height="18"
                                        VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="#F1F1F1F1" Opacity="0.47" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Button
                                        x:Name="DislikeButton"
                                        Style="{StaticResource RatingIconButtonStyle}"
                                        Padding="8,8,16,8"
                                        Background="Transparent"
                                        Click="DislikeButton_Click"
                                        BorderThickness="0"
                                        Foreground="White">
                                        <Image
                                            x:Name="DislikeIcon"
                                            Width="20"
                                            Height="20"
                                            Source="Assets/player/dislike.png" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border
                                Margin="0,0,8,0"
                                Background="#272727"
                                CornerRadius="18">
                                <Button
                                    x:Name="ShareButton"
                                    Padding="16,8"
                                    Background="Transparent"
                                    Click="ShareButton_Click"
                                    BorderThickness="0"
                                    Foreground="White">
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Source="Assets/player/send.png" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="14"
                                            Foreground="White"
                                            Text="Share" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Playlist / mix ("jam") queue — collapsible card in the content column  -->
                    <Border
                        x:Name="PlaylistQueuePanel"
                        Grid.Row="4"
                        Margin="16,0,16,16"
                        Padding="12"
                        Background="#272727"
                        CornerRadius="12"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Button
                                x:Name="PlaylistQueueHeaderButton"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="PlaylistQueueHeaderButton_Click">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="PlaylistQueueTitleText"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            MaxLines="1"
                                            Text="Playlist"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="PlaylistQueuePositionText"
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="#AAAAAA"
                                            Text="" />
                                    </StackPanel>
                                    <Image
                                        x:Name="PlaylistQueueChevron"
                                        Grid.Column="1"
                                        Width="18"
                                        Height="18"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Source="Assets/down_arrow.png" />
                                </Grid>
                            </Button>

                            <ItemsControl
                                x:Name="PlaylistQueueContainer"
                                Margin="0,10,0,0"
                                Visibility="Visible">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,0,10"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="PlaylistQueueItem_Click">
                                            <Grid HorizontalAlignment="Stretch"
                                                  Background="{Binding row_background}"
                                                  Padding="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Grid.Column="0"
                                                    Width="104"
                                                    Height="58"
                                                    Background="Black"
                                                    CornerRadius="6">
                                                    <Border CornerRadius="6">
                                                        <Image
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            Source="{Binding thumbnail}"
                                                            Stretch="UniformToFill" />
                                                    </Border>
                                                    <!--  "Now playing" marker  -->
                                                    <Border Background="#CC000000"
                                                            Visibility="{Binding now_playing_visibility}">
                                                        <TextBlock Text="▶"
                                                                   Foreground="White"
                                                                   FontSize="20"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Foreground="White"
                                                        LineHeight="17"
                                                        MaxLines="2"
                                                        Text="{Binding title}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="12"
                                                        Foreground="#AAAAAA"
                                                        MaxLines="1"
                                                        Text="{Binding author}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="CommentsContainerButton"
                        Grid.Row="5"
                        Margin="16,0,16,16"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CommentsContainerButton_Click"
                        Visibility="Visible">
                        <Border
                            x:Name="LastCommentContainer"
                            Padding="12"
                            Background="#272727"
                            CornerRadius="12">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="Comments" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Grid.Column="0"
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                        <Ellipse Fill="#333333" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="LastCommentAuthorImage" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="LastCommentAuthor"
                                                Grid.Column="0"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#AAAAAA"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                x:Name="LastCommentTime"
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                FontSize="12"
                                                Foreground="#666666" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="LastCommentText"
                                            FontSize="13"
                                            Foreground="White"
                                            MaxLines="2"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Button>

                    <StackPanel
                        x:Name="RelatedPanelVertical"
                        Grid.Row="6"
                        Visibility="Collapsed">
                        <ProgressRing
                            x:Name="RelatedVideosLoadingRingVertical"
                            Width="30"
                            Height="30"
                            Margin="0,20"
                            Foreground="White" />
                        <StackPanel
                            x:Name="RelatedVideosFallbackVertical"
                            Visibility="Collapsed">
                            <Border Margin="0,0,0,24" Background="Transparent" HorizontalAlignment="Stretch">
                                <Grid
                                    HorizontalAlignment="Stretch"
                                    SizeChanged="RelatedSkeletonCardHost_SizeChanged">
                                    <Image
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ImageOpened="SkeletonCardImage_ImageOpened"
                                        Source="ms-appx:///Assets/yt_skeleton/video.png"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <Border Margin="0,0,0,24" Background="Transparent" HorizontalAlignment="Stretch">
                                <Grid
                                    HorizontalAlignment="Stretch"
                                    SizeChanged="RelatedSkeletonCardHost_SizeChanged">
                                    <Image
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ImageOpened="SkeletonCardImage_ImageOpened"
                                        Source="ms-appx:///Assets/yt_skeleton/video.png"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <Border Margin="0,0,0,24" Background="Transparent" HorizontalAlignment="Stretch">
                                <Grid
                                    HorizontalAlignment="Stretch"
                                    SizeChanged="RelatedSkeletonCardHost_SizeChanged">
                                    <Image
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ImageOpened="SkeletonCardImage_ImageOpened"
                                        Source="ms-appx:///Assets/yt_skeleton/video.png"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <Border Margin="0,0,0,24" Background="Transparent" HorizontalAlignment="Stretch">
                                <Grid
                                    HorizontalAlignment="Stretch"
                                    SizeChanged="RelatedSkeletonCardHost_SizeChanged">
                                    <Image
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ImageOpened="SkeletonCardImage_ImageOpened"
                                        Source="ms-appx:///Assets/yt_skeleton/video.png"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <Border Margin="0,0,0,24" Background="Transparent" HorizontalAlignment="Stretch">
                                <Grid
                                    HorizontalAlignment="Stretch"
                                    SizeChanged="RelatedSkeletonCardHost_SizeChanged">
                                    <Image
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ImageOpened="SkeletonCardImage_ImageOpened"
                                        Source="ms-appx:///Assets/yt_skeleton/video.png"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>

                        </StackPanel>
                        <ItemsControl x:Name="RelatedVideosContainerVertical">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
