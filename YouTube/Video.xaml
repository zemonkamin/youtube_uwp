        </Grid>

        <!-- Bottom Sheet Panel for Subscription / Notification Menu -->
        <Grid x:Name="SubscriptionMenuBottomSheetPanel" Grid.Row="1"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="#222222"
              CornerRadius="15"
              Height="300"
              Margin="10,0,10,10"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SubscriptionMenuBottomSheetTransform" Y="280"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  Height="40"
                  Tapped="SubscriptionMenuDragArea_Tapped"
                  PointerPressed="SubscriptionMenuDragArea_PointerPressed"
                  PointerMoved="SubscriptionMenuDragArea_PointerMoved"
                  PointerReleased="SubscriptionMenuDragArea_PointerReleased"
                  PointerCaptureLost="SubscriptionMenuDragArea_PointerReleased">
                <Rectangle Width="40"
                           Height="4"
                           Fill="Gray"
                           RadiusX="2"
                           RadiusY="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,20">
                <StackPanel>
                    <TextBlock Text="Notifications"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"
                               FontSize="16"/>

                    <Button x:Name="NotificationAllOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationAllOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/all_notifications.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="All" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <FontIcon x:Name="NotificationAllCheckmark" Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NotificationPersonalizedOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationPersonalizedOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/notifications.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Personalized" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <FontIcon x:Name="NotificationPersonalizedCheckmark" Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NotificationNoneOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationNoneOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/none_notifications.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="None" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <FontIcon x:Name="NotificationNoneCheckmark" Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NotificationUnsubscribeOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationUnsubscribeOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/unsubscribe.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Unsubscribe" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom Sheet Panel for Share -->
        <Grid x:Name="ShareBottomSheetPanel" Grid.Row="1"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="Transparent"
              Height="340"
              Margin="8,0,8,6"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShareBottomSheetTransform" Y="360"/>
            </Grid.RenderTransform>

            <Border Background="#1F1F1F" CornerRadius="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="Transparent"
                          Height="36"
                          Tapped="ShareDragArea_Tapped"
                          PointerPressed="ShareDragArea_PointerPressed"
                          PointerMoved="ShareDragArea_PointerMoved"
                          PointerReleased="ShareDragArea_PointerReleased"
                          PointerCaptureLost="ShareDragArea_PointerReleased">
                        <Border Width="50"
                                Height="5"
                                Background="#B7B7B7"
                                CornerRadius="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ShareVideoTitleText"
                                               Grid.Column="0"
                                               TextWrapping="WrapWholeWords"
                                               MaxLines="2"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <TextBlock x:Name="ShareTimestampText"
                                               Grid.Column="1"
                                               Text="0:00"
                                               Foreground="White"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <Button x:Name="ShareTimeToggleButton"
                                            Grid.Column="2"
                                            Width="58"
                                            Height="30"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Style="{StaticResource ShareTimeToggleButtonNoHoverStyle}"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="ShareTimeToggleButton_Click"
                                            Loaded="ShareTimeToggleButton_Loaded"
                                            Unloaded="ShareTimeToggleButton_Unloaded">
                                        <Grid Width="58" Height="30" Background="Transparent">
                                            <Border x:Name="ShareTimeToggleTrack"
                                                    BorderThickness="0"
                                                    CornerRadius="15">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="ShareTimeToggleTrackBrush" Color="#A8A8A8"/>
                                                </Border.Background>
                                            </Border>
                                            <Ellipse x:Name="ShareTimeToggleKnob"
                                                     Width="22"
                                                     Height="22"
                                                     Fill="#202124"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,0,0">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="ShareTimeToggleKnobTransform" X="0"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="ShareChannelText"
                                           Foreground="#B8B8B8"
                                           FontSize="12.5"
                                           Margin="0,0,0,16"/>

                                <Border Background="#2C2C2C" CornerRadius="16" Padding="12,10,12,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Source="Assets/link.png" Stretch="Uniform"/>
                                        <TextBlock x:Name="ShareUrlTextBox"
                                                   Grid.Column="1"
                                                   Foreground="#F1F1F1"
                                                   FontSize="13"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ShareButtonsPanel">
                                    <Button x:Name="CopyLinkButton"
                                            Style="{StaticResource ShareActionButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,7"
                                            Click="CopyLinkButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" Background="#343434" CornerRadius="26" VerticalAlignment="Center">
                                                <Image Width="24" Height="24" Source="Assets/copy.png" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Copy link" Foreground="White" VerticalAlignment="Center" FontSize="15" Margin="14,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShowQrCodeButton"
                                            Style="{StaticResource ShareActionButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,7"
                                            Click="ShowQrCodeButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" Background="#343434" CornerRadius="26" VerticalAlignment="Center">
                                                <Image Width="24" Height="24" Source="Assets/qr.png" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Show QR code" Foreground="White" VerticalAlignment="Center" FontSize="15" Margin="14,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShareViaSystemButton"
                                            Style="{StaticResource ShareActionButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="ShareViaSystemButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" Background="#343434" CornerRadius="26" VerticalAlignment="Center">
                                                <Image Width="24" Height="24" Source="Assets/share.png" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Share via..." Foreground="White" VerticalAlignment="Center" FontSize="15" Margin="14,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SharePopupOverlay"
              Grid.Row="1"
              Background="#88000000"
              Visibility="Collapsed"
              Tapped="SharePopupOverlay_Tapped">
            <Grid VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Width="318"
                  MaxWidth="318"
                  Tapped="SharePopupContainer_Tapped">
                <Border Background="#1F1F1F" CornerRadius="24" Padding="18,16,18,18">
                    <StackPanel>

                        <TextBlock x:Name="SharePopupTitleText"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords"
                                   Margin="0,0,0,10"/>
                        <Border x:Name="SharePopupImageHolder"
                                Width="224"
                                Height="224"
                                HorizontalAlignment="Center"
                                Background="#2C2C2C"
                                CornerRadius="18"
                                Padding="10"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <Grid Width="204" Height="204">
                                <Border Background="#2C2C2C" CornerRadius="14"/>
                                <Image x:Name="SharePopupImage"
                                       Width="204"
                                       Height="204"
                                       Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SharePopupMessageText"
                                   Foreground="#E8E8E8"
                                   FontSize="13"
                                   FontFamily="Segoe UI"
                                   TextWrapping="WrapWholeWords"
                                   Margin="0,0,0,16"/>
                        <Button x:Name="SharePopupCloseButton"
                                Height="42"
                                HorizontalAlignment="Stretch"
                                Click="SharePopupCloseButton_Click"
                                Background="#2D2D2D"
                                Foreground="White"
                                BorderBrush="#2D2D2D"
                                Content="Close"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Sheet Panel for Settings -->
        <Grid x:Name="SettingsBottomSheetPanel" Grid.Row="1" 
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Stretch"
              Background="#222222"
              CornerRadius="15"
              Height="195"
              Margin="10,0,10,10"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SettingsBottomSheetTransform" Y="205"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Full-width drag area -->
            <Grid Grid.Row="0" 
                  Background="Transparent"
                  Height="40"
                  Tapped="SettingsDragArea_Tapped"
                  PointerPressed="SettingsDragArea_PointerPressed"
                  PointerMoved="SettingsDragArea_PointerMoved"
                  PointerReleased="SettingsDragArea_PointerReleased"
                  PointerCaptureLost="SettingsDragArea_PointerReleased">
                <!-- Visible drag handle -->
                <Rectangle Width="40" 
                           Height="4" 
                           Fill="Gray" 
                           RadiusX="2" 
                           RadiusY="2" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Settings Content with Direct Panel Switching -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <!-- Main Settings Panel with two full-width buttons -->
                <StackPanel x:Name="MainSettingsPanel">
                    <!-- Quality Button -->
                    <Button x:Name="QualityButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="QualityButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/player/quality.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Quality" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="QualityValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" Source="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Speed Button -->
                    <Button x:Name="SpeedButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="SpeedButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Playback speed" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="SpeedValueText" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" Source="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Audio track Button -->
                    <Button x:Name="AudioTrackButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Visibility="Collapsed"
                            Click="AudioTrackButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Audio track" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <Image Grid.Column="2" Source="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Subtitles Button -->
                    <Button x:Name="SubtitlesButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="SubtitlesButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/player/comments.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Subtitles" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <Image Grid.Column="2" Source="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Reload Button -->
                    <Button x:Name="ReloadButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="ReloadButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="Assets/player/reload.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="Reload video" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                            <!-- No skip.png indicator for this button -->
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Quality Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="QualitySettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Quality" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>

                        <StackPanel x:Name="QualityOptionsPanel">
                            <!-- Quality options will be added here dynamically -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Audio track Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="AudioTrackSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Audio track" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>
                        <StackPanel x:Name="AudioTrackOptionsPanel"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Subtitles Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="SubtitlesSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Subtitles" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>

                        <StackPanel x:Name="SubtitlesOptionsPanel">
                            <!-- Subtitle options will be added here dynamically -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Speed Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="SpeedSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Playback speed" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>

                        <StackPanel x:Name="SpeedOptionsPanel">
                            <!-- Speed options will be added here dynamically -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RelatedColumn.Width" Value="0" />
                        <Setter Target="RelatedPanel.Visibility" Value="Collapsed" />
                        <Setter Target="RelatedPanelVertical.Visibility" Value="Visible" />
                        <Setter Target="SkeletonRelatedColumn.Width" Value="0" />
                        <Setter Target="SkeletonRightPart.Visibility" Value="Collapsed" />
                        <Setter Target="SkeletonRelatedVerticalPart.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RelatedColumn.Width" Value="400" />
                        <Setter Target="RelatedPanel.Visibility" Value="Visible" />
                        <Setter Target="RelatedPanelVertical.Visibility" Value="Collapsed" />
                        <Setter Target="SkeletonRelatedColumn.Width" Value="400" />
                        <Setter Target="SkeletonRightPart.Visibility" Value="Visible" />
                        <Setter Target="SkeletonRelatedVerticalPart.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>