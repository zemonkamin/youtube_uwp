                                    Padding="0"
                                    BorderThickness="0"
                                    Click="DescriptionCloseButton_Click"
                                    Background="Transparent"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <SymbolIcon Symbol="Cancel" Foreground="{ThemeResource AppPrimaryTextBrush}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding ElementName=VideoTitleText, Path=Text}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- Stats -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatLikes" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="14" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <Viewbox
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        Stretch="Uniform"
                                        StretchDirection="DownOnly">
                                        <TextBlock
                                            Text="{Binding ElementName=LikeCountText, Path=Text}"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource AppPrimaryTextBrush}"
                                            TextWrapping="NoWrap" />
                                    </Viewbox>
                                    <Viewbox Height="16"
                                             HorizontalAlignment="Left"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly">
                                        <TextBlock x:Uid="Loc_Likes_Text"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   TextWrapping="NoWrap"/>
                                    </Viewbox>
                                </StackPanel>
                            </Border>
                            <Border x:Name="StatViews" Grid.Column="1" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="14" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <Viewbox
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        Stretch="Uniform"
                                        StretchDirection="DownOnly">
                                        <TextBlock
                                            Text="{Binding ElementName=VideoViewsText, Path=Text}"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource AppPrimaryTextBrush}"
                                            TextWrapping="NoWrap" />
                                    </Viewbox>
                                    <Viewbox Height="16"
                                             HorizontalAlignment="Left"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly">
                                        <TextBlock x:Uid="Loc_Views_Text"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   TextWrapping="NoWrap"/>
                                    </Viewbox>
                                </StackPanel>
                            </Border>
                            <Border x:Name="StatDate" Grid.Column="2" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="14" Padding="12">
                                <StackPanel>
                                    <Viewbox
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        Stretch="Uniform"
                                        StretchDirection="DownOnly">
                                        <TextBlock
                                            Text="{Binding ElementName=VideoUploadDateText, Path=Text}"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource AppPrimaryTextBrush}"
                                            TextWrapping="NoWrap" />
                                    </Viewbox>
                                    <Viewbox Height="16"
                                             HorizontalAlignment="Left"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly">
                                        <TextBlock x:Uid="Loc_Published_Text"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   TextWrapping="NoWrap"/>
                                    </Viewbox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Description text -->
                        <Border x:Name="DescriptionBox"
                                Background="{ThemeResource AppSurfaceBrush}"
                                CornerRadius="16"
                                Padding="12,10"
                                Margin="0,4,0,0">
                            <RichTextBlock x:Name="DescriptionTextBlock" 
                                           TextWrapping="Wrap" 
                                           Foreground="{ThemeResource AppPrimaryTextBrush}" 
                                           FontSize="14"
                                           Margin="0,0,0,0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Bottom Sheet Panel for Comments -->
        <Grid x:Name="CommentsBottomSheetPanel" Grid.Row="1" 
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Stretch"
              Background="{ThemeResource AppDividerBrush}"
              CornerRadius="15"
              Height="400"
              Margin="10,0,10,6"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="CommentsBottomSheetTransform" Y="410"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Full-width drag area -->
            <Grid Grid.Row="0" 
                  Background="Transparent"
                  Height="40"
                  Tapped="CommentsDragArea_Tapped"
                  PointerPressed="CommentsDragArea_PointerPressed"
                  PointerMoved="CommentsDragArea_PointerMoved"
                  PointerReleased="CommentsDragArea_PointerReleased"
                  PointerCaptureLost="CommentsDragArea_PointerReleased">
                <!-- Visible drag handle -->
                <Rectangle Width="40" 
                           Height="4" 
                           Fill="Gray" 
                           RadiusX="2" 
                           RadiusY="2" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Comments Content -->
            <Grid Grid.Row="1" Margin="16,0,16,18">
                <ScrollViewer
                    x:Name="CommentsScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommentsItemsControl" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,10,0,10" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                        <Ellipse Fill="{ThemeResource AvatarPlaceholderBrush}" />
                                        <Ellipse DataContextChanged="CommentAuthorImage_DataContextChanged"
                                                 Loaded="CommentAuthorImage_Loaded">
                                            <Ellipse.Fill>
                                                <ImageBrush Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                FontWeight="Bold"
                                                Text="{Binding Author}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                FontSize="12"
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding PublishedAt}" />
                                        </Grid>
                                        <RichTextBlock
                                            Margin="0,4,0,0"
                                            FontSize="14"
                                            Foreground="{ThemeResource AppPrimaryTextBrush}"
                                            HorizontalAlignment="Stretch"
                                            IsTextSelectionEnabled="False"
                                            Loaded="CommentTextRichTextBlock_Loaded"
                                            Tag="{Binding Text}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Bottom Sheet Panel for Subscription / Notification Menu -->
        <Grid x:Name="SubscriptionMenuBottomSheetPanel" Grid.Row="1"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource AppDividerBrush}"
              CornerRadius="15"
              Height="300"
              Margin="10,0,10,10"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SubscriptionMenuBottomSheetTransform" Y="280"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  Height="40"
                  Tapped="SubscriptionMenuDragArea_Tapped"
                  PointerPressed="SubscriptionMenuDragArea_PointerPressed"
                  PointerMoved="SubscriptionMenuDragArea_PointerMoved"
                  PointerReleased="SubscriptionMenuDragArea_PointerReleased"
                  PointerCaptureLost="SubscriptionMenuDragArea_PointerReleased">
                <Rectangle Width="40"
                           Height="4"
                           Fill="Gray"
                           RadiusX="2"
                           RadiusY="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,20">
                <StackPanel>
                    <TextBlock x:Uid="Loc_Notifications_Text"
                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"
                               FontSize="16"/>

                    <Button x:Name="NotificationAllOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationAllOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/all_notifications.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_All_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <FontIcon x:Name="NotificationAllCheckmark" Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource AppPrimaryTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NotificationPersonalizedOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationPersonalizedOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/notifications.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_Personalized_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <FontIcon x:Name="NotificationPersonalizedCheckmark" Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource AppPrimaryTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NotificationNoneOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationNoneOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/none_notifications.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_None_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <FontIcon x:Name="NotificationNoneCheckmark" Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource AppPrimaryTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NotificationUnsubscribeOptionButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="NotificationUnsubscribeOptionButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/unsubscribe.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_Unsubscribe_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom Sheet Panel for Share -->
        <Grid x:Name="ShareBottomSheetPanel" Grid.Row="1"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="Transparent"
              MaxHeight="330"
              Margin="10,0,10,10"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShareBottomSheetTransform" Y="340"/>
            </Grid.RenderTransform>

            <Border Background="{ThemeResource AppSurfaceAltBrush}" CornerRadius="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="Transparent"
                          Height="40"
                          Tapped="ShareDragArea_Tapped"
                          PointerPressed="ShareDragArea_PointerPressed"
                          PointerMoved="ShareDragArea_PointerMoved"
                          PointerReleased="ShareDragArea_PointerReleased"
                          PointerCaptureLost="ShareDragArea_PointerReleased">
                        <Border Width="40"
                                Height="4"
                                Background="Gray"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,0,20,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ShareVideoTitleText"
                                               Grid.Column="0"
                                               TextWrapping="WrapWholeWords"
                                               MaxLines="2"
                                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <TextBlock x:Name="ShareTimestampText"
                                               Grid.Column="1"
                                               Text="0:00"
                                               Foreground="{ThemeResource AppPrimaryTextBrush}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <Button x:Name="ShareTimeToggleButton"
                                            Grid.Column="2"
                                            Width="50"
                                            Height="28"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Style="{StaticResource ShareTimeToggleButtonNoHoverStyle}"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="ShareTimeToggleButton_Click"
                                            Loaded="ShareTimeToggleButton_Loaded"
                                            Unloaded="ShareTimeToggleButton_Unloaded">
                                        <Grid Width="50" Height="28" Background="Transparent">
                                            <Border x:Name="ShareTimeToggleTrack"
                                                    BorderThickness="0"
                                                    CornerRadius="14">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="ShareTimeToggleTrackBrush" Color="{ThemeResource AppMutedTextColor}"/>
                                                </Border.Background>
                                            </Border>
                                            <Ellipse x:Name="ShareTimeToggleKnob"
                                                     Width="20"
                                                     Height="20"
                                                     Fill="{ThemeResource ToggleKnobBrush}"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,0,0">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="ShareTimeToggleKnobTransform" X="0"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="ShareChannelText"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           FontSize="14"
                                           Margin="0,0,0,12"/>

                                <Border Background="{ThemeResource AppSurfaceBrush}" CornerRadius="12" Padding="12,10,12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center" local:ThemeAsset.Path="Assets/link.png" Stretch="Uniform"/>
                                        <TextBlock x:Name="ShareUrlTextBox"
                                                   Grid.Column="1"
                                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                                   FontSize="14"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="ShareButtonsPanel">
                                    <Button x:Name="CopyLinkButton"
                                            Style="{StaticResource ShareActionButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            Click="CopyLinkButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="18" VerticalAlignment="Center">
                                                <Image Width="24" Height="24" local:ThemeAsset.Path="Assets/copy.png" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Uid="Loc_CopyLink_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShowQrCodeButton"
                                            Style="{StaticResource ShareActionButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            Click="ShowQrCodeButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="18" VerticalAlignment="Center">
                                                <Image Width="24" Height="24" local:ThemeAsset.Path="Assets/qr.png" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Uid="Loc_ShowQRCode_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ShareViaSystemButton"
                                            Style="{StaticResource ShareActionButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="ShareViaSystemButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="18" VerticalAlignment="Center">
                                                <Image Width="24" Height="24" local:ThemeAsset.Path="Assets/share.png" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Uid="Loc_ShareVia_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Copy-link / QR result sheet. Uses the same floating bottom-sheet geometry as Share. -->
        <Grid x:Name="SharePopupOverlay"
              Grid.Row="1"
              Background="Transparent"
              Visibility="Collapsed"
              Tapped="SharePopupOverlay_Tapped">
            <Border x:Name="SharePopupPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="10,0,10,10"
                    MaxHeight="390"
                    Background="{ThemeResource AppSurfaceAltBrush}"
                    CornerRadius="15"
                    Tapped="SharePopupContainer_Tapped">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SharePopupTransform" Y="400"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Height="40"
                          Background="Transparent"
                          Tapped="SharePopupDragArea_Tapped"
                          PointerPressed="SharePopupDragArea_PointerPressed"
                          PointerMoved="SharePopupDragArea_PointerMoved"
                          PointerReleased="SharePopupDragArea_PointerReleased"
                          PointerCaptureLost="SharePopupDragArea_PointerReleased">
                        <Border Width="40"
                                Height="4"
                                Background="Gray"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="20,0,20,12">
                        <TextBlock x:Name="SharePopupTitleText"
                                   Foreground="{ThemeResource AppPrimaryTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords"
                                   Margin="0,0,0,10"/>
                        <Border x:Name="SharePopupImageHolder"
                                Width="224"
                                Height="224"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource AppSurfaceBrush}"
                                CornerRadius="15"
                                Padding="10"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <Grid Width="204" Height="204">
                                <Border Background="{ThemeResource AppSurfaceBrush}" CornerRadius="12"/>
                                <Image x:Name="SharePopupImage"
                                       Width="204"
                                       Height="204"
                                       Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SharePopupMessageText"
                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                   FontSize="13"
                                   FontFamily="Segoe UI"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Sheet Panel for Settings -->
        <Grid x:Name="SettingsBottomSheetPanel" Grid.Row="1" 
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Stretch"
              Background="{ThemeResource AppDividerBrush}"
              CornerRadius="15"
              Height="195"
              Margin="10,0,10,10"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SettingsBottomSheetTransform" Y="205"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Full-width drag area -->
            <Grid Grid.Row="0" 
                  Background="Transparent"
                  Height="40"
                  Tapped="SettingsDragArea_Tapped"
                  PointerPressed="SettingsDragArea_PointerPressed"
                  PointerMoved="SettingsDragArea_PointerMoved"
                  PointerReleased="SettingsDragArea_PointerReleased"
                  PointerCaptureLost="SettingsDragArea_PointerReleased">
                <!-- Visible drag handle -->
                <Rectangle Width="40" 
                           Height="4" 
                           Fill="Gray" 
                           RadiusX="2" 
                           RadiusY="2" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Settings Content with Direct Panel Switching -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <!-- Main Settings Panel with two full-width buttons -->
                <StackPanel x:Name="MainSettingsPanel">
                    <!-- Quality Button -->
                    <Button x:Name="QualityButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="QualityButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/quality.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_Quality_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="QualityValueText" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Speed Button -->
                    <Button x:Name="SpeedButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="SpeedButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_PlaybackSpeed_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="2" x:Name="SpeedValueText" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                            <Image Grid.Column="3" local:ThemeAsset.Path="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Audio track Button -->
                    <Button x:Name="AudioTrackButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Visibility="Collapsed"
                            Click="AudioTrackButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/speed.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_AudioTrack_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <Image Grid.Column="2" local:ThemeAsset.Path="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Subtitles Button -->
                    <Button x:Name="SubtitlesButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="SubtitlesButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/comments.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_Subtitles_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <Image Grid.Column="2" local:ThemeAsset.Path="Assets/player/skip.png" Width="16" Height="16" Margin="14,0,0,0" Opacity="0.6"/>
                        </Grid>
                    </Button>

                    <!-- Reload Button -->
                    <Button x:Name="ReloadButton"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,4,0,4"
                            Height="Auto"
                            MinHeight="44"
                            Margin="0,0,0,4"
                            Click="ReloadButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" local:ThemeAsset.Path="Assets/player/reload.png" Width="24" Height="24" Margin="0,0,16,0"/>
                            <TextBlock x:Uid="Loc_ReloadVideo_Text" Grid.Column="1" Foreground="{ThemeResource AppPrimaryTextBrush}" VerticalAlignment="Center" FontSize="16"/>
                            <!-- No skip.png indicator for this button -->
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Quality Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="QualitySettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Uid="Loc_Quality_Text" Foreground="{ThemeResource AppPrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>

                        <StackPanel x:Name="QualityOptionsPanel">
                            <!-- Quality options will be added here dynamically -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Audio track Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="AudioTrackSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Uid="Loc_AudioTrack_Text" Foreground="{ThemeResource AppPrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>
                        <StackPanel x:Name="AudioTrackOptionsPanel"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Subtitles Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="SubtitlesSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Uid="Loc_Subtitles_Text" Foreground="{ThemeResource AppPrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>

                        <StackPanel x:Name="SubtitlesOptionsPanel">
                            <!-- Subtitle options will be added here dynamically -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Speed Settings Panel with ScrollViewer -->
                <ScrollViewer x:Name="SpeedSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Uid="Loc_PlaybackSpeed_Text" Foreground="{ThemeResource AppPrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,16" FontSize="16"/>

                        <StackPanel x:Name="SpeedOptionsPanel">
                            <!-- Speed options will be added here dynamically -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RelatedColumn.Width" Value="0" />
                        <Setter Target="RelatedPanel.Visibility" Value="Collapsed" />
                        <Setter Target="RelatedPanelVertical.Visibility" Value="Visible" />
                        <Setter Target="SkeletonRelatedColumn.Width" Value="0" />
                        <Setter Target="SkeletonRightPart.Visibility" Value="Collapsed" />
                        <Setter Target="SkeletonRelatedVerticalPart.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RelatedColumn.Width" Value="400" />
                        <Setter Target="RelatedPanel.Visibility" Value="Visible" />
                        <Setter Target="RelatedPanelVertical.Visibility" Value="Collapsed" />
                        <Setter Target="SkeletonRelatedColumn.Width" Value="400" />
                        <Setter Target="SkeletonRightPart.Visibility" Value="Visible" />
                        <Setter Target="SkeletonRelatedVerticalPart.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>